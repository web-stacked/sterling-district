.env
.env.*
!.env.example
.dev.vars
.dev.vars.*

# local production deploy config (real Cloudflare binding IDs)
wrangler.production.toml
wrangler.toml.orig

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/
