---
import Layout from '../../layouts/Layout.astro';
import { getContentEntry, getContentCollection } from '../../lib/content';
import { img } from '../../lib/image';
import { linkify } from '../../lib/linkify';
import type { ProductData } from '../../content-schema';

const { slug } = Astro.params;

const { entries: allProducts } = await getContentCollection<ProductData>('products');
const productEntry = allProducts.find((p) => p.data.slug === slug);

if (!productEntry) {
  return Astro.redirect('/404');
}

const { entry: detailEntry, error: detailError } = await getContentEntry('pages', 'product-detail');
if (detailError || !detailEntry) return Astro.rewrite('/500');
const detail = detailEntry.data as Record<string, any>;

const product = productEntry.data;
const productId = productEntry.id;
const {
  name,
  price,
  description,
  details,
  specifications,
  images,
} = product;
---

<Layout title={name}>
  <!-- Breadcrumb -->
  <div class="bg-gray-50 border-b border-gray-100">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-4">
      <nav class="flex items-center gap-2 text-sm font-body">
        <a href="/" class="text-gray-400 hover:text-secondary transition-colors" data-caret="pages::product-detail::breadcrumb.home">{detail.breadcrumb.home}</a>
        <svg class="w-4 h-4 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
        </svg>
        <a href="/products" class="text-gray-400 hover:text-secondary transition-colors" data-caret="pages::product-detail::breadcrumb.products">{detail.breadcrumb.products}</a>
        <svg class="w-4 h-4 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
        </svg>
        <span class="text-primary truncate max-w-[200px]" data-caret={`products::${productId}::name`}>{name}</span>
      </nav>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10 lg:py-16">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16">
      {/* Image gallery */}
      <div class="flex flex-col gap-4">
        <!-- Main Slider -->
        <div class="relative group">
          <div class="embla main-slider">
          <div class="embla__container">
            {images.map((image, index) => (
              <div
                class="embla__slide slide-item aspect-square bg-gray-50 overflow-hidden cursor-zoom-in"
                data-index={index}
                data-full={img.lightbox(image)}
              >
                <img
                  src={img.product(image)}
                  alt={`${name} - Image ${index + 1}`}
                  class="w-full h-full object-cover transition-transform duration-500 ease-out hover:scale-105"
                  loading={index === 0 ? "eager" : "lazy"} data-caret={`products::${productId}::images.${index}`}
                />
              </div>
            ))}
          </div>
        </div>

          <!-- Navigation Arrows -->
          {images.length > 1 && (
            <>
              <button
                class="main-prev absolute left-4 top-1/2 -translate-y-1/2 w-11 h-11 bg-white/90 hover:bg-white flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all duration-300 shadow-md hover:shadow-lg z-10"
                aria-label="Previous image"
              >
                <svg class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
                </svg>
              </button>
              <button
                class="main-next absolute right-4 top-1/2 -translate-y-1/2 w-11 h-11 bg-white/90 hover:bg-white flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all duration-300 shadow-md hover:shadow-lg z-10"
                aria-label="Next image"
              >
                <svg class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
              </button>
            </>
          )}

          <!-- Zoom hint -->
          <div class="zoom-hint absolute bottom-4 left-4 bg-primary/80 text-white text-[11px] px-3 py-1.5 font-medium tracking-wider uppercase z-10 flex items-center gap-2 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7" />
            </svg>
            Zoom
          </div>

          <!-- Slide Counter -->
          {images.length > 1 && (
            <div class="absolute bottom-4 right-4 bg-primary/80 text-white text-[11px] px-3 py-1.5 font-medium tracking-wider z-10">
              <span class="current-slide">1</span> / {images.length}
            </div>
          )}
        </div>

        <!-- Thumbnails -->
        {images.length > 1 && (
          <div class="grid grid-cols-4 gap-2">
            {images.map((image, index) => (
              <button
                class="thumb-btn relative aspect-square overflow-hidden transition-all duration-300 group/thumb"
                data-index={index}
              >
                <img
                  src={img.thumb(image)}
                  alt={`${name} thumbnail ${index + 1}`}
                  class="w-full h-full object-cover transition-transform duration-300 group-hover/thumb:scale-110"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-primary/20 opacity-100 group-hover/thumb:opacity-0 transition-opacity duration-300 thumb-overlay"></div>
                <div class="absolute inset-0 border-2 border-transparent transition-all duration-300 thumb-border"></div>
              </button>
            ))}
          </div>
        )}
      </div>

      {/* Product info */}
      <div class="lg:sticky lg:top-28 lg:self-start">
        <div class="flex flex-col">
          <!-- Header -->
          <div class="pb-6 border-b border-gray-200">
            <span class="inline-block font-body text-secondary text-[11px] tracking-[0.2em] uppercase mb-3" data-caret="pages::product-detail::brand_label">{detail.brand_label}</span>
            <h1 class="text-2xl sm:text-3xl font-heading text-primary mb-4 leading-tight" data-caret={`products::${productId}::name`}>{name}</h1>
            <p class="text-2xl sm:text-3xl text-secondary font-body font-medium tracking-wide" data-caret={`products::${productId}::price`}>{'$' + price.toLocaleString()}</p>
          </div>

          <!-- Description -->
          <div class="py-6 border-b border-gray-200">
            <p class="text-gray-600 leading-relaxed font-body" data-caret={`products::${productId}::description`} set:html={linkify(description)} />
          </div>

          <!-- Details -->
          {details && details.length > 0 && (
            <div class="py-6 border-b border-gray-200">
              <h2 class="text-xs tracking-[0.15em] uppercase text-primary font-medium mb-4" data-caret="pages::product-detail::sections.details">{detail.sections.details}</h2>
              <ul class="space-y-2.5">
                {details.map((detail_item, i) => (
                  <li class="flex items-start gap-3">
                    <svg class="w-4 h-4 text-secondary flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                    </svg>
                    <span class="text-gray-600 text-sm font-body" data-caret={`products::${productId}::details.${i}`} set:html={linkify(detail_item)} />
                  </li>
                ))}
              </ul>
            </div>
          )}

          <!-- Specifications -->
          {specifications && Object.keys(specifications).length > 0 && (
            <div class="py-6 border-b border-gray-200">
              <h2 class="text-xs tracking-[0.15em] uppercase text-primary font-medium mb-4" data-caret="pages::product-detail::sections.specifications">{detail.sections.specifications}</h2>
              <dl class="space-y-3">
                {Object.entries(specifications).map(([key, value]) => value && (
                  <div class="flex items-center justify-between">
                    <dt class="text-gray-500 text-sm font-body capitalize">{key}</dt>
                    <dd class="text-primary text-sm font-medium font-body" data-caret={`products::${productId}::specifications.${key}`}>{value}</dd>
                  </div>
                ))}
              </dl>
            </div>
          )}

          <!-- CTA Button -->
          <div class="pt-8">
            <div class="flex flex-col gap-3">
              <a href="/contact" class="w-full bg-primary hover:bg-secondary text-white px-6 py-4 text-xs tracking-[0.15em] uppercase font-medium transition-all duration-300 text-center" data-caret="pages::product-detail::actions.request_info">
                {detail.actions.request_info}
              </a>
            </div>

            <!-- Trust badges -->
            <div class="mt-8 pt-6 border-t border-gray-100">
              <div class="grid grid-cols-3 gap-4 text-center">
                <div class="flex flex-col items-center gap-2">
                  <svg class="w-5 h-5 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
                  </svg>
                  <span class="text-[10px] tracking-wider uppercase text-gray-500" data-caret="pages::product-detail::trust.certified">{detail.trust.certified}</span>
                </div>
                <div class="flex flex-col items-center gap-2">
                  <svg class="w-5 h-5 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.125-.504 1.125-1.125v-2.25m-17.25 4.5V7.5A1.5 1.5 0 014.875 6h8.25m7.5 9V13.5a.75.75 0 01.75-.75h1.5a.75.75 0 01.75.75v3.75" />
                  </svg>
                  <span class="text-[10px] tracking-wider uppercase text-gray-500" data-caret="pages::product-detail::trust.free_shipping">{detail.trust.free_shipping}</span>
                </div>
                <div class="flex flex-col items-center gap-2">
                  <svg class="w-5 h-5 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" />
                  </svg>
                  <span class="text-[10px] tracking-wider uppercase text-gray-500" data-caret="pages::product-detail::trust.returns">{detail.trust.returns}</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Lightbox -->
  <div id="lightbox" class="fixed inset-0 z-50 pointer-events-none flex items-center justify-center">
    <!-- Backdrop -->
    <div id="lightbox-backdrop" class="absolute inset-0 bg-black/0 transition-all duration-500 ease-out"></div>

    <!-- Close button -->
    <button id="lightbox-close" class="absolute top-4 right-4 w-12 h-12 flex items-center justify-center text-white/70 hover:text-white transition-all duration-300 z-20 opacity-0 translate-y-2">
      <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <!-- Counter -->
    <div id="lightbox-counter" class="absolute top-4 left-4 text-white/70 text-sm font-medium tracking-wide z-20 opacity-0 translate-y-2 transition-all duration-300">
      1 / {images.length}
    </div>

    <!-- Navigation -->
    {images.length > 1 && (
      <>
        <button id="lightbox-prev" class="absolute left-4 top-1/2 -translate-y-1/2 w-14 h-14 flex items-center justify-center text-white/70 hover:text-white transition-all duration-300 z-20 opacity-0 -translate-x-4">
          <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
          </svg>
        </button>
        <button id="lightbox-next" class="absolute right-4 top-1/2 -translate-y-1/2 w-14 h-14 flex items-center justify-center text-white/70 hover:text-white transition-all duration-300 z-20 opacity-0 translate-x-4">
          <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </>
    )}

    <!-- Image container -->
    <div id="lightbox-content" class="relative w-full h-full flex items-center justify-center p-8 md:p-16 z-10">
      <img
        id="lightbox-img"
        src={img.lightbox(images[0])}
        alt=""
        class="max-w-full max-h-full object-contain opacity-0 scale-90 transition-all duration-500 ease-out"
      />
    </div>

    <!-- Thumbnails strip -->
    {images.length > 1 && (
      <div class="absolute bottom-4 left-1/2 -translate-x-1/2 flex gap-2 z-20 opacity-0 translate-y-4 transition-all duration-300" id="lightbox-thumbs">
        {images.map((image, index) => (
          <button
            class="lightbox-thumb w-16 h-16 overflow-hidden opacity-50 hover:opacity-80 transition-all duration-200 border-2 border-transparent"
            data-index={index}
            data-src={img.lightbox(image)}
          >
            <img src={img.thumb(image)} alt="" class="w-full h-full object-cover" />
          </button>
        ))}
      </div>
    )}
  </div>
</Layout>

<style>
  @reference "../../styles/base.css";

  .embla {
    overflow: hidden;
  }
  .embla__container {
    display: flex;
  }
  .embla__slide {
    flex: 0 0 100%;
    min-width: 0;
  }

  /* Active thumbnail */
  .thumb-btn.active .thumb-overlay {
    opacity: 0;
  }
  .thumb-btn.active .thumb-border {
    border-color: var(--color-secondary);
  }

  /* Lightbox active */
  #lightbox.active {
    pointer-events: auto;
  }
  #lightbox.active #lightbox-backdrop {
    background-color: rgba(0, 0, 0, 0.95);
  }
  #lightbox.active #lightbox-img {
    opacity: 1;
    transform: scale(1);
  }
  #lightbox.active #lightbox-close,
  #lightbox.active #lightbox-counter {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 200ms;
  }
  #lightbox.active #lightbox-prev {
    opacity: 1;
    transform: translate(0, -50%);
    transition-delay: 250ms;
  }
  #lightbox.active #lightbox-next {
    opacity: 1;
    transform: translate(0, -50%);
    transition-delay: 250ms;
  }
  #lightbox.active #lightbox-thumbs {
    opacity: 1;
    transform: translate(-50%, 0);
    transition-delay: 300ms;
  }

  /* Lightbox active thumb */
  .lightbox-thumb.active {
    opacity: 1;
    border-color: var(--color-secondary);
  }

  /* Keyboard focus styles */
  .thumb-btn:focus-visible,
  .dot:focus-visible,
  .main-prev:focus-visible,
  .main-next:focus-visible {
    outline: 2px solid var(--color-secondary);
    outline-offset: 2px;
  }
</style>

<script>
  import EmblaCarousel, { type EmblaCarouselType } from 'embla-carousel';

  const sliderEl = document.querySelector('.main-slider') as HTMLElement | null;
  if (sliderEl) {
    const thumbBtns = Array.from(document.querySelectorAll('.thumb-btn'));
    const prevBtn = document.querySelector('.main-prev');
    const nextBtn = document.querySelector('.main-next');
    const slideItems = Array.from(document.querySelectorAll('.slide-item'));
    const slideCounter = document.querySelector('.current-slide');
    const lightbox = document.getElementById('lightbox');
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
    const lightboxClose = document.getElementById('lightbox-close');
    const lightboxPrev = document.getElementById('lightbox-prev');
    const lightboxNext = document.getElementById('lightbox-next');
    const lightboxCounter = document.getElementById('lightbox-counter');
    const lightboxThumbs = Array.from(document.querySelectorAll('.lightbox-thumb'));
    let currentLightboxIndex = 0;
    const totalImages = slideItems.length;
    function getImageUrl(index: number): string {
      const item = slideItems[index];
      return item?.getAttribute('data-full') || item?.querySelector('img')?.src || '';
    }

    let embla: EmblaCarouselType | null = null;

    const openLightbox = (index: number) => {
      currentLightboxIndex = index;
      const url = getImageUrl(index);
      new Image().src = url; // preload

      if (lightboxImg) {
        lightboxImg.src = url;
        lightboxImg.alt = `Image ${index + 1}`;
      }

      if (lightboxCounter) {
        lightboxCounter.textContent = `${index + 1} / ${totalImages}`;
      }

      lightboxThumbs.forEach((thumb, i) => {
        thumb.classList.toggle('active', i === index);
      });

      requestAnimationFrame(() => {
        lightbox?.classList.add('active');
        document.body.style.overflow = 'hidden';
      });
    };

    const closeLightbox = () => {
      lightbox?.classList.remove('active');
      document.body.style.overflow = '';
    };

    const updateLightbox = (animate = true) => {
      if (!lightboxImg) return;
      const url = getImageUrl(currentLightboxIndex);

      if (animate) {
        lightboxImg.style.opacity = '0';
        lightboxImg.style.transform = 'scale(0.95)';

        setTimeout(() => {
          lightboxImg.src = url;
          lightboxImg.alt = `Image ${currentLightboxIndex + 1}`;

          requestAnimationFrame(() => {
            lightboxImg.style.opacity = '1';
            lightboxImg.style.transform = 'scale(1)';
          });
        }, 200);
      } else {
        lightboxImg.src = url;
        lightboxImg.alt = `Image ${currentLightboxIndex + 1}`;
      }

      if (lightboxCounter) {
        lightboxCounter.textContent = `${currentLightboxIndex + 1} / ${totalImages}`;
      }

      lightboxThumbs.forEach((thumb, i) => {
        thumb.classList.toggle('active', i === currentLightboxIndex);
      });
    };

    const lightboxPrevSlide = () => {
      currentLightboxIndex = (currentLightboxIndex - 1 + totalImages) % totalImages;
      updateLightbox();
    };

    const lightboxNextSlide = () => {
      currentLightboxIndex = (currentLightboxIndex + 1) % totalImages;
      updateLightbox();
    };

    // Wait for images to load, then init carousel
    const slideImages = sliderEl.querySelectorAll('img');
    const imagePromises = Array.from(slideImages).map((img) => {
      if (img.complete) return Promise.resolve();
      return new Promise<void>((resolve) => {
        img.addEventListener('load', () => resolve(), { once: true });
        img.addEventListener('error', () => resolve(), { once: true });
      });
    });

    Promise.race([
      Promise.all(imagePromises),
      new Promise((resolve) => setTimeout(resolve, 2000)),
    ]).then(() => {
      embla = EmblaCarousel(sliderEl, {
        loop: true,
        duration: 25,
        dragFree: false,
      });

      const updateCarouselUI = () => {
        if (!embla) return;
        const index = embla.selectedScrollSnap();
        thumbBtns.forEach((btn, i) => btn.classList.toggle('active', i === index));
        if (slideCounter) slideCounter.textContent = String(index + 1);
      };

      embla.on('init', () => {
        updateCarouselUI();
        sliderEl.dataset.ready = 'true';
      });
      embla.on('select', updateCarouselUI);
      embla.on('reInit', updateCarouselUI);
    });

    // Thumbnails
    thumbBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        if (!embla) return;
        const index = parseInt(btn.getAttribute('data-index') || '0', 10);
        embla.scrollTo(index);
      });
    });

    prevBtn?.addEventListener('click', () => embla?.scrollPrev());
    nextBtn?.addEventListener('click', () => embla?.scrollNext());

    // Keyboard navigation for carousel
    document.addEventListener('keydown', (e) => {
      if (!embla || lightbox?.classList.contains('active')) return;
      if (e.key === 'ArrowLeft') embla.scrollPrev();
      else if (e.key === 'ArrowRight') embla.scrollNext();
    });

    // Open lightbox on slide click
    slideItems.forEach((item) => {
      item.addEventListener('click', () => {
        const index = parseInt(item.getAttribute('data-index') || '0', 10);
        openLightbox(index);
      });
    });

    // Lightbox controls
    lightboxClose?.addEventListener('click', closeLightbox);
    lightboxPrev?.addEventListener('click', lightboxPrevSlide);
    lightboxNext?.addEventListener('click', lightboxNextSlide);

    lightboxThumbs.forEach((thumb) => {
      thumb.addEventListener('click', () => {
        const index = parseInt(thumb.getAttribute('data-index') || '0', 10);
        currentLightboxIndex = index;
        updateLightbox();
      });
    });

    lightbox?.addEventListener('click', (e) => {
      if (e.target === lightbox || (e.target as HTMLElement).id === 'lightbox-content') {
        closeLightbox();
      }
    });

    // Keyboard navigation for lightbox
    document.addEventListener('keydown', (e) => {
      if (!lightbox?.classList.contains('active')) return;
      if (e.key === 'Escape') closeLightbox();
      else if (e.key === 'ArrowLeft') lightboxPrevSlide();
      else if (e.key === 'ArrowRight') lightboxNextSlide();
    });

  }
</script>
