---
import Layout from '../layouts/Layout.astro';
import { getContentEntry } from '../lib/content';
import { img } from '../lib/image';
import { linkify } from '../lib/linkify';

const { entry: pageEntry, error: pageError } = await getContentEntry('pages', 'services');
if (pageError || !pageEntry) return Astro.rewrite('/500');
const svc = pageEntry.data as Record<string, any>;

const services = svc.services as Array<{
	id: string;
	title: string;
	subtitle: string;
	description: string;
	features: string[];
	image: string;
	cta: string;
}>;
---

<Layout title="Our Services - Sterling District" darkHero={true}>
	<!-- Hero Section -->
	<section class="relative section-spacing-hero bg-primary overflow-hidden">
		<div class="absolute inset-0">
			<img
				src={img.hero(svc.hero.bg_image)}
				alt="Jewelry Craftsmanship"
				class="w-full h-full object-cover opacity-40" data-caret="pages::services::hero.bg_image"
			/>
			<div class="absolute inset-0 bg-gradient-to-b from-primary/70 via-primary/50 to-primary"></div>
		</div>

		<div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-secondary/40 to-transparent"></div>

		<div class="relative z-10 container mx-auto px-4 text-center">
			<div class="flex items-center justify-center gap-6 mb-8">
				<span class="hidden sm:block w-12 h-px bg-gradient-to-r from-transparent to-secondary/60"></span>
				<span class="font-body text-secondary/80 text-[11px] tracking-[0.5em] uppercase" data-caret="pages::services::hero.label">{svc.hero.label}</span>
				<span class="hidden sm:block w-12 h-px bg-gradient-to-l from-transparent to-secondary/60"></span>
			</div>
			<h1 class="font-heading text-4xl md:text-5xl lg:text-6xl xl:text-7xl text-white mb-6 font-light">
				<span data-caret="pages::services::hero.headline">{svc.hero.headline}</span> <span class="italic text-secondary" data-caret="pages::services::hero.headline_accent">{svc.hero.headline_accent}</span>
			</h1>
			<p class="font-body text-white/70 text-lg max-w-2xl mx-auto leading-relaxed" data-caret="pages::services::hero.subtext">
				{svc.hero.subtext}
			</p>
		</div>
	</section>

	<!-- Services Navigation -->
	<section class="section-spacing-bar bg-white border-b border-gray-100 md:sticky md:top-[72px] z-40 backdrop-blur-xl bg-white/95">
		<div class="container mx-auto px-4">
			<div class="flex flex-wrap justify-center gap-4 md:gap-8">
				{services.map((service, i) => (
					<a
						href={`#${service.id}`}
						class="font-body text-xs tracking-[0.15em] uppercase text-gray-500 hover:text-secondary transition-colors duration-300 py-2" data-caret={`pages::services::services.${i}.title`}
					>
						{service.title}
					</a>
				))}
			</div>
		</div>
	</section>

	<!-- Services Sections -->
	{services.map((service, index) => (
		<section id={service.id} class={`section-spacing ${index % 2 === 0 ? 'bg-white' : 'bg-gray-50'}`}>
			<div class="container mx-auto px-4">
				<div class={`grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center max-w-6xl mx-auto ${index % 2 !== 0 ? 'lg:grid-flow-dense' : ''}`}>
					<!-- Text Content -->
					<div class={index % 2 !== 0 ? 'lg:col-start-2' : ''}>
						<span class="label-badge" data-caret={`pages::services::services.${index}.subtitle`}>{service.subtitle}</span>
						<h2 class="font-heading text-3xl md:text-4xl lg:text-5xl text-primary mb-6" data-caret={`pages::services::services.${index}.title`}>{service.title}</h2>
						<p class="font-body text-gray-600 text-lg leading-relaxed mb-8" data-caret={`pages::services::services.${index}.description`} set:html={linkify(service.description)} />

						<ul class="space-y-4 mb-10">
							{service.features.map((feature, fi) => (
								<li class="flex items-start gap-4">
									<span class="w-6 h-6 rounded-full bg-secondary/10 flex items-center justify-center flex-shrink-0 mt-0.5">
										<svg class="w-3 h-3 text-secondary" fill="currentColor" viewBox="0 0 20 20">
											<path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
										</svg>
									</span>
									<span class="font-body text-gray-600" data-caret={`pages::services::services.${index}.features.${fi}`} set:html={linkify(feature)} />
								</li>
							))}
						</ul>

						<a
							href="/contact"
							class="inline-flex items-center justify-center px-8 py-4 bg-primary text-white text-xs tracking-[0.2em] uppercase font-medium hover:bg-secondary transition-all duration-500 group"
						>
							<span data-caret={`pages::services::services.${index}.cta`}>{service.cta}</span>
							<svg class="w-4 h-4 ml-3 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
							</svg>
						</a>
					</div>

					<!-- Image -->
					<div class={`relative ${index % 2 !== 0 ? 'lg:col-start-1 lg:row-start-1' : ''}`}>
						<div class="relative overflow-hidden group">
							<img
								src={img.service(service.image)}
								alt={service.title}
								class="w-full aspect-[4/3] object-cover transform group-hover:scale-105 transition-transform duration-700"
								loading="lazy" data-caret={`pages::services::services.${index}.image`}
							/>
							<div class="absolute inset-0 bg-gradient-to-t from-primary/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
						</div>
						<!-- Decorative accent -->
						<div class={`absolute -z-10 w-full h-full bg-secondary/10 ${index % 2 === 0 ? '-bottom-4 -right-4' : '-bottom-4 -left-4'}`}></div>
					</div>
				</div>
			</div>
		</section>
	))}

	<!-- Process Section -->
	<section class="section-spacing bg-primary text-white relative overflow-hidden">
		<div class="absolute inset-0 opacity-5">
			<img src={img.hero(svc.process.bg_image)} alt="" class="w-full h-full object-cover" data-caret="pages::services::process.bg_image"/>
		</div>
		<div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-secondary/30 to-transparent"></div>

		<div class="container mx-auto px-4 relative z-10">
			<div class="text-center section-header-spacing">
				<span class="label-badge" data-caret="pages::services::process.label">{svc.process.label}</span>
				<h2 class="font-heading text-3xl md:text-4xl lg:text-5xl text-white mb-6" data-caret="pages::services::process.headline">{svc.process.headline}</h2>
				<p class="font-body text-white/70 max-w-2xl mx-auto" data-caret="pages::services::process.subtext">{svc.process.subtext}</p>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-4 gap-8 max-w-5xl mx-auto">
				{svc.process.steps.map((item: { step: string; title: string; desc: string }, i: number) => (
					<div class="text-center group">
						<div class="w-16 h-16 mx-auto mb-6 border border-secondary/30 rounded-full flex items-center justify-center group-hover:bg-secondary/10 transition-colors duration-300">
							<span class="font-heading text-2xl text-secondary" data-caret={`pages::services::process.steps.${i}.step`}>{item.step}</span>
						</div>
						<h3 class="font-heading text-xl text-white mb-3" data-caret={`pages::services::process.steps.${i}.title`}>{item.title}</h3>
						<p class="font-body text-white/60 text-sm" data-caret={`pages::services::process.steps.${i}.desc`} set:html={linkify(item.desc)} />
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- CTA Section -->
	<section class="section-spacing-cta bg-gray-50">
		<div class="container mx-auto px-4">
			<div class="max-w-4xl mx-auto text-center">
				<span class="label-badge" data-caret="pages::services::cta.label">{svc.cta.label}</span>
				<h2 class="font-heading text-3xl md:text-4xl lg:text-5xl text-primary mb-6">
					<span data-caret="pages::services::cta.headline">{svc.cta.headline}</span> <span class="italic text-secondary" data-caret="pages::services::cta.headline_accent">{svc.cta.headline_accent}</span>
				</h2>
				<p class="font-body text-gray-600 text-lg mb-10 max-w-2xl mx-auto" data-caret="pages::services::cta.subtext">
					{svc.cta.subtext}
				</p>
				<div class="flex flex-col sm:flex-row gap-4 justify-center">
					<a
						href="/contact"
						class="inline-flex items-center justify-center px-10 py-5 bg-primary text-white text-xs tracking-[0.2em] uppercase font-medium hover:bg-secondary transition-all duration-500" data-caret="pages::services::cta.cta_primary"
					>
						{svc.cta.cta_primary}
					</a>
					<a
						href="tel:2125551234"
						class="inline-flex items-center justify-center px-10 py-5 border-2 border-primary text-primary text-xs tracking-[0.2em] uppercase font-medium hover:bg-primary hover:text-white transition-all duration-500" data-caret="pages::services::cta.cta_secondary"
					>
						{svc.cta.cta_secondary}
					</a>
				</div>
			</div>
		</div>
	</section>
</Layout>
