---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/HeroSection.astro';
import FaqSection from '../components/FaqSection.astro';
import TestimonialSection from '../components/TestimonialSection.astro';
import { getContentEntry, getContentCollection } from '../lib/content';
import { img } from '../lib/image';
import { linkify } from '../lib/linkify';
import type { ProductData, TestimonialData, FaqData } from '../content-schema';

const { entry: homeEntry, error: homeError } = await getContentEntry('pages', 'home');
if (homeError || !homeEntry) return Astro.rewrite('/500');
const home = homeEntry.data as Record<string, any>;

const { entries: productEntries } = await getContentCollection<ProductData>('products');
const featuredProducts = productEntries.filter(p => p.data.featured).slice(0, 3);

const { entries: faqEntries } = await getContentCollection<FaqData>('faqs');
const faqs = faqEntries.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

const { entries: testimonialEntries } = await getContentCollection<TestimonialData>('testimonials');
const testimonials = testimonialEntries.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
---

<Layout title="Sterling District - Fine Jewelry & Diamond Services" darkHero={true}>
	<HeroSection pageId="home" hero={home.hero} />

	<!-- Trust Badges -->
	<section class="section-spacing-bar bg-white/98 border-b border-gray-100/80 md:sticky md:top-[--header-height] z-40 backdrop-blur-xl">
		<div class="container mx-auto px-4">
			<div class="flex flex-wrap justify-center items-center gap-8 md:gap-16 lg:gap-24">
				{(home.trust_badges as string[]).map((badge: string, i: number) => (
					<div class="flex items-center gap-3 text-gray-400 group cursor-default">
						<span class="w-1 h-1 rounded-full bg-secondary/60"></span>
						<span class="font-body text-[10px] tracking-[0.15em] uppercase font-medium" data-caret={`pages::home::trust_badges.${i}`}>{badge}</span>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- Featured Products -->
	<section class="section-spacing bg-white relative overflow-hidden">
		<div class="container mx-auto px-4">
			<div class="text-center section-header-spacing reveal-on-scroll">
				<span class="label-badge" data-caret="pages::home::featured.label">{home.featured.label}</span>
				<h2 class="font-heading text-4xl md:text-5xl lg:text-6xl text-primary mb-6" data-caret="pages::home::featured.headline">{home.featured.headline}</h2>
				<p class="font-body text-gray-500 max-w-2xl mx-auto text-lg" data-caret="pages::home::featured.subtext">
					{home.featured.subtext}
				</p>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-3 gap-10 mb-16">
				{featuredProducts.map((product, index: number) => (
					<a href={`/products/${product.data.slug}`} class="group reveal-on-scroll h-full" data-delay={index + 1}>
						<div class="relative bg-gray-50 rounded-sm overflow-hidden shadow-sm hover:shadow-2xl transition-all duration-500 h-full flex flex-col border border-gray-100 hover:border-secondary/40">
							<div class="relative aspect-[4/3] overflow-hidden flex-shrink-0">
								<img
									src={img.card(product.data.images[0])}
									alt={product.data.name}
									class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-700 ease-out"
								/>
								<div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
								<span class="absolute top-4 left-4 bg-secondary text-white text-[10px] tracking-[0.2em] uppercase px-4 py-2 shadow-lg">
									Featured
								</span>
								<!-- Quick View Button -->
								<div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300">
									<span class="bg-white text-primary px-6 py-3 text-xs tracking-widest uppercase font-medium shadow-xl transform translate-y-4 group-hover:translate-y-0 transition-transform duration-300">
										View Details
									</span>
								</div>
							</div>
							<div class="p-6 bg-white flex-grow flex flex-col justify-between">
								<h3 class="font-heading text-xl text-primary mb-3 group-hover:text-secondary transition-colors duration-300 line-clamp-2">{product.data.name}</h3>
								<div class="flex items-center justify-between">
									<span class="font-body text-secondary text-lg font-semibold">{'$' + product.data.price.toLocaleString()}</span>
									<span class="inline-flex items-center text-primary/50 text-xs group-hover:text-secondary transition-colors">
										<svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
										</svg>
									</span>
								</div>
							</div>
						</div>
					</a>
				))}
			</div>

			<div class="text-center reveal-on-scroll">
				<a href="/products" class="inline-flex items-center justify-center px-10 py-5 border-2 border-primary text-primary text-xs tracking-[0.2em] uppercase font-medium hover:bg-primary hover:text-white transition-all duration-500 group">
					<span data-caret="pages::home::featured.cta">{home.featured.cta}</span>
					<svg class="w-4 h-4 ml-3 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
					</svg>
				</a>
			</div>
		</div>
	</section>

	<!-- Diamond Craftsmanship -->
	<section class="section-spacing bg-primary text-white relative overflow-hidden">
		<div class="absolute inset-0 opacity-5">
			<img src={img.hero(home.craftsmanship.bg_image)} data-caret="pages::home::craftsmanship.bg_image" alt="" class="w-full h-full object-cover"/>
		</div>
		<div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-secondary/30 to-transparent"></div>

		<div class="container mx-auto px-4 relative z-10">
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-center">
				<div class="reveal-on-scroll">
					<span class="label-badge" data-caret="pages::home::craftsmanship.label">{home.craftsmanship.label}</span>
					<h2 class="font-heading text-4xl md:text-5xl lg:text-6xl text-white mb-8 leading-tight">
						<span data-caret="pages::home::craftsmanship.headline">{home.craftsmanship.headline}</span><br/><span class="italic text-secondary" data-caret="pages::home::craftsmanship.headline_accent">{home.craftsmanship.headline_accent}</span>
					</h2>
					<p class="font-body text-white/70 text-lg mb-10 leading-relaxed" data-caret="pages::home::craftsmanship.description">
						{home.craftsmanship.description}
					</p>
					<a href="/services" class="inline-flex items-center text-secondary hover:text-white transition-colors group">
						<span class="text-sm tracking-[0.15em] uppercase font-medium" data-caret="pages::home::craftsmanship.cta">{home.craftsmanship.cta}</span>
						<svg class="w-5 h-5 ml-3 transform group-hover:translate-x-2 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
						</svg>
					</a>
				</div>

				<div class="grid grid-cols-2 gap-4 reveal-on-scroll" data-delay="2">
					{(home.craftsmanship.stats as any[]).map((stat: any, i: number) => (
						<div class="stat-card bg-white/5 backdrop-blur-sm border border-white/10 p-8 lg:p-10 text-center hover:bg-white/10 transition-colors duration-300">
							<div class="font-heading text-4xl lg:text-5xl text-secondary mb-3" data-caret={`pages::home::craftsmanship.stats.${i}.value`}>{stat.value}</div>
							<div class="font-body text-[11px] tracking-[0.2em] uppercase text-white/60" data-caret={`pages::home::craftsmanship.stats.${i}.label`}>{stat.label}</div>
						</div>
					))}
				</div>
			</div>
		</div>
	</section>

	<!-- Why Choose Us -->
	<section class="section-spacing bg-gray-50">
		<div class="container mx-auto px-4">
			<div class="text-center section-header-spacing reveal-on-scroll">
				<span class="label-badge" data-caret="pages::home::why_us.label">{home.why_us.label}</span>
				<h2 class="font-heading text-4xl md:text-5xl lg:text-6xl text-primary mb-6" data-caret="pages::home::why_us.headline">{home.why_us.headline}</h2>
				<p class="font-body text-gray-500 max-w-xl mx-auto" data-caret="pages::home::why_us.subtext">{home.why_us.subtext}</p>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
				{(home.why_us.features as any[]).map((feature: any, i: number) => (
					<div class="feature-card bg-white p-10 text-center group hover:shadow-2xl transition-all duration-500 reveal-on-scroll" data-delay={i + 1}>
						<div class="w-16 h-16 mx-auto mb-8 bg-secondary/10 rounded-full flex items-center justify-center group-hover:bg-secondary group-hover:scale-110 transition-all duration-500">
							{feature.icon === "sparkle" && (
								<svg class="w-7 h-7 text-secondary group-hover:text-white transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
									<path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z"/>
								</svg>
							)}
							{feature.icon === "globe" && (
								<svg class="w-7 h-7 text-secondary group-hover:text-white transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
									<path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418"/>
								</svg>
							)}
							{feature.icon === "document" && (
								<svg class="w-7 h-7 text-secondary group-hover:text-white transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
									<path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"/>
								</svg>
							)}
							{feature.icon === "gift" && (
								<svg class="w-7 h-7 text-secondary group-hover:text-white transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
									<path stroke-linecap="round" stroke-linejoin="round" d="M21 11.25v8.25a1.5 1.5 0 01-1.5 1.5H5.25a1.5 1.5 0 01-1.5-1.5v-8.25M12 4.875A2.625 2.625 0 109.375 7.5H12m0-2.625V7.5m0-2.625A2.625 2.625 0 1114.625 7.5H12m0 0V21m-8.625-9.75h18c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125h-18c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z"/>
								</svg>
							)}
						</div>
						<h3 class="font-heading text-xl text-primary mb-4" data-caret={`pages::home::why_us.features.${i}.title`}>{feature.title}</h3>
						<p class="font-body text-gray-500 text-sm leading-relaxed" data-caret={`pages::home::why_us.features.${i}.desc`} set:html={linkify(feature.desc)} />
					</div>
				))}
			</div>
		</div>
	</section>

	<FaqSection pageId="home" label={home.faq.label} headline={home.faq.headline} faqs={faqs} />

	<TestimonialSection
		pageId="home"
		label={home.testimonials.label}
		headline={home.testimonials.headline}
		subtext={home.testimonials.subtext}
		style={home.testimonials.style ?? 'minimal'}
		testimonials={testimonials}
	/>

	<!-- CTA Section -->
	<section class="section-spacing-cta bg-primary relative overflow-hidden">
		<div class="absolute inset-0 opacity-20">
			<img src={img.hero(home.cta.bg_image)} data-caret="pages::home::cta.bg_image" alt="" class="w-full h-full object-cover"/>
		</div>
		<div class="absolute inset-0 bg-gradient-to-br from-primary via-primary/95 to-primary/90"></div>
		<div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-secondary/30 to-transparent"></div>

		<div class="container mx-auto px-4 relative z-10 text-center reveal-on-scroll">
			<span class="label-badge mb-6" data-caret="pages::home::cta.label">{home.cta.label}</span>
			<h2 class="font-heading text-4xl md:text-5xl lg:text-6xl xl:text-7xl text-white mb-8 leading-tight">
				<span data-caret="pages::home::cta.headline">{home.cta.headline}</span><br/><span class="italic text-secondary" data-caret="pages::home::cta.headline_accent">{home.cta.headline_accent}</span>
			</h2>
			<p class="font-body text-white/70 text-lg max-w-2xl mx-auto mb-14" data-caret="pages::home::cta.subtext">
				{home.cta.subtext}
			</p>

			<div class="flex flex-col sm:flex-row gap-4 sm:gap-6 justify-center">
				<a href="/contact" class="inline-flex items-center justify-center px-10 py-5 bg-white text-primary text-xs tracking-[0.2em] uppercase font-medium hover:bg-secondary hover:text-white transition-all duration-500 shadow-lg" data-caret="pages::home::cta.cta_primary">
					{home.cta.cta_primary}
				</a>
				<a href="/products" class="inline-flex items-center justify-center px-10 py-5 border-2 border-white/30 text-white text-xs tracking-[0.2em] uppercase font-medium hover:bg-white hover:text-primary transition-all duration-500" data-caret="pages::home::cta.cta_secondary">
					{home.cta.cta_secondary}
				</a>
			</div>
		</div>
	</section>
</Layout>

