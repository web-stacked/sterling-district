---
import Layout from '../layouts/Layout.astro';
import { getContentEntry } from '../lib/content';
import { img } from '../lib/image';
import { linkify } from '../lib/linkify';
import type { SiteGlobalData } from '../content-schema';

const contactEndpoint = import.meta.env.PUBLIC_CONTACT_FORM_ENDPOINT ?? '';

const { entry: pageEntry, error: pageError } = await getContentEntry('pages', 'contact');
if (pageError || !pageEntry) return Astro.rewrite('/500');
const page = pageEntry.data as Record<string, any>;

const { entry: siteEntry } = await getContentEntry<SiteGlobalData>('site', 'global');
const site = siteEntry?.data;
---

<Layout title="Contact Us - Sterling District" darkHero={true}>
	<!-- Hero Section -->
	<section class="relative section-spacing-hero bg-primary overflow-hidden">
		<div class="absolute inset-0">
			<img
				src={img.hero(page.hero.bg_image)}
				alt="Luxury Jewelry"
				class="w-full h-full object-cover opacity-40" data-caret="pages::contact::hero.bg_image"
			/>
			<div class="absolute inset-0 bg-gradient-to-b from-primary/70 via-primary/60 to-primary"></div>
		</div>

		<div class="relative z-10 container mx-auto px-4 text-center">
			<span class="label-badge mb-6 animate-fade-in" data-caret="pages::contact::hero.label">{page.hero.label}</span>
			<h1 class="font-heading text-4xl md:text-5xl lg:text-6xl text-white mb-6" data-caret="pages::contact::hero.headline">{page.hero.headline}</h1>
			<p class="font-body text-white/80 text-lg max-w-2xl mx-auto leading-relaxed" data-caret="pages::contact::hero.subtext">
				{page.hero.subtext}
			</p>
		</div>
	</section>

	<!-- Contact Content -->
	<section class="section-spacing bg-gray-50">
		<div class="container mx-auto px-4">
			<div class="max-w-6xl mx-auto">

				<!-- Response Guarantee Banner -->
				<div class="mb-12 text-center">
					<div class="inline-flex items-center gap-3 px-6 py-3 bg-secondary/10 border border-secondary/20">
						<svg class="w-5 h-5 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
							<path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/>
						</svg>
						<span class="font-body text-sm text-primary" data-caret="pages::contact::response_banner" set:html={linkify(page.response_banner)} />
					</div>
				</div>

				<!-- Main Grid: Form + Info -->
				<div class="grid grid-cols-1 lg:grid-cols-3 gap-8 lg:gap-12">

					<!-- Contact Form (Takes 2 columns) -->
					<div class="lg:col-span-2 order-2 lg:order-1">
						<div class="bg-white p-8 md:p-10 lg:p-12 shadow-soft border border-gray-100">
							<div class="mb-8">
								<h2 class="font-heading text-2xl md:text-3xl text-primary mb-2" data-caret="pages::contact::form.heading">{page.form.heading}</h2>
								<p class="font-body text-gray-500 text-sm" data-caret="pages::contact::form.required_note">{page.form.required_note}</p>
							</div>

							<form id="contactForm" class="space-y-6" method="POST" data-endpoint={contactEndpoint}>
								<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
									<!-- Name Field -->
									<div class="form-group">
										<label for="name" class="block font-body text-sm text-gray-700 mb-2">
											<span data-caret="pages::contact::form.name_label">{page.form.name_label}</span> <span class="text-secondary" data-caret="pages::contact::text">*</span>
										</label>
										<input
											type="text"
											id="name"
											name="name"
											required
											autocomplete="name"
											class="form-input w-full px-4 py-3.5 border border-gray-200 bg-white font-body text-sm text-primary placeholder:text-gray-400 focus:outline-none focus:border-secondary focus:ring-2 focus:ring-secondary/20 transition-all duration-200"
											placeholder={page.form.name_placeholder}
										/>
									</div>

									<!-- Email Field -->
									<div class="form-group">
										<label for="email" class="block font-body text-sm text-gray-700 mb-2">
											<span data-caret="pages::contact::form.email_label">{page.form.email_label}</span> <span class="text-secondary" data-caret="pages::contact::text_2">*</span>
										</label>
										<input
											type="email"
											id="email"
											name="email"
											required
											autocomplete="email"
											class="form-input w-full px-4 py-3.5 border border-gray-200 bg-white font-body text-sm text-primary placeholder:text-gray-400 focus:outline-none focus:border-secondary focus:ring-2 focus:ring-secondary/20 transition-all duration-200"
											placeholder={page.form.email_placeholder}
										/>
									</div>
								</div>

								<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
									<!-- Phone Field -->
									<div class="form-group">
										<label for="phone" class="block font-body text-sm text-gray-700 mb-2">
											<span data-caret="pages::contact::form.phone_label">{page.form.phone_label}</span> <span class="text-gray-400 text-xs" data-caret="pages::contact::optional">(optional)</span>
										</label>
										<input
											type="tel"
											id="phone"
											name="phone"
											inputmode="tel"
											autocomplete="tel"
											pattern="[\d\s\-\(\)]{10,}"
											class="form-input w-full px-4 py-3.5 border border-gray-200 bg-white font-body text-sm text-primary placeholder:text-gray-400 focus:outline-none focus:border-secondary focus:ring-2 focus:ring-secondary/20 transition-all duration-200"
											placeholder={page.form.phone_placeholder}
										/>
									</div>

									<!-- Service Field -->
									<div class="form-group">
										<label for="service" class="block font-body text-sm text-gray-700 mb-2">
											<span data-caret="pages::contact::form.service_label">{page.form.service_label}</span> <span class="text-secondary" data-caret="pages::contact::text_3">*</span>
										</label>
										<div class="relative">
											<select
												id="service"
												name="service"
												required
												class="form-select w-full px-4 py-3.5 pr-10 border border-gray-200 bg-white font-body text-sm text-primary focus:outline-none focus:border-secondary focus:ring-2 focus:ring-secondary/20 transition-all duration-200 appearance-none cursor-pointer"
											>
												<option value="" class="text-gray-400">Select a service</option>
												{page.form.service_options.map((opt: string) => (
													<option value={opt.toLowerCase().replace(/\s+/g, '-')}>{opt}</option>
												))}
											</select>
											<svg class="absolute right-4 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
												<path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
											</svg>
										</div>
									</div>
								</div>

								<!-- Message Field with Character Count -->
								<div class="form-group">
									<label for="message" class="block font-body text-sm text-gray-700 mb-2">
										<span data-caret="pages::contact::form.message_label">{page.form.message_label}</span> <span class="text-secondary" data-caret="pages::contact::text_4">*</span>
									</label>
									<textarea
										id="message"
										name="message"
										rows="5"
										required
										maxlength="1000"
										aria-describedby="message-count"
										class="form-input w-full px-4 py-3.5 border border-gray-200 bg-white font-body text-sm text-primary placeholder:text-gray-400 focus:outline-none focus:border-secondary focus:ring-2 focus:ring-secondary/20 transition-all duration-200 resize-none"
										placeholder={page.form.message_placeholder}
									></textarea>
									<p id="message-count" class="text-gray-400 text-xs mt-2 text-right">
										<span id="charCount" data-caret="pages::contact::text_5">0</span>/1000 characters
									</p>
								</div>

								<!-- Submit Button -->
								<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pt-2">
									<button
										type="submit"
										id="submitBtn"
										class="inline-flex items-center justify-center px-8 py-4 bg-primary text-white text-sm tracking-wide font-medium hover:bg-secondary focus:ring-2 focus:ring-secondary/50 focus:ring-offset-2 transition-all duration-300 group disabled:opacity-70 disabled:cursor-not-allowed"
									>
										<span id="btnText" data-caret="pages::contact::form.submit_button">{page.form.submit_button}</span>
										<svg id="btnArrow" class="w-4 h-4 ml-3 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
										</svg>
										<svg id="btnSpinner" class="hidden w-4 h-4 ml-3 animate-spin" fill="none" viewBox="0 0 24 24">
											<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
											<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
										</svg>
									</button>

									<!-- Privacy Note -->
									<p class="text-xs text-gray-400 flex items-center gap-1.5">
										<svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
											<path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z"/>
										</svg>
										<span data-caret="pages::contact::form.privacy_notice">{page.form.privacy_notice}</span>
									</p>
								</div>

								<!-- Status Messages (ARIA live region) -->
								<div id="formStatus" role="status" aria-live="polite" class="mt-6">
									<!-- Success Message -->
									<div id="successMessage" class="hidden p-5 bg-green-50 border border-green-200">
										<div class="flex items-start gap-3">
											<svg class="w-5 h-5 text-green-600 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
												<path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
											</svg>
											<div>
												<p class="font-medium text-sm text-green-800" data-caret="pages::contact::intro">Message sent successfully</p>
												<p class="text-sm text-green-700 mt-1" data-caret="pages::contact::body">Thank you for reaching out. We'll get back to you within 24 hours.</p>
											</div>
										</div>
									</div>

									<!-- Error Message -->
									<div id="errorMessage" class="hidden p-5 bg-red-50 border border-red-200">
										<div class="flex items-start gap-3">
											<svg class="w-5 h-5 text-red-600 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
												<path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
											</svg>
											<div>
												<p class="font-medium text-sm text-red-800" data-caret="pages::contact::body_2">Unable to send message</p>
												<p id="errorMessageText" class="text-sm text-red-700 mt-1" data-caret="pages::contact::body_3">Please check your input and try again, or call us directly.</p>
											</div>
										</div>
									</div>
								</div>
							</form>
						</div>
					</div>

					<!-- Contact Info Sidebar -->
					<div class="lg:col-span-1 order-1 lg:order-2">
						<div class="bg-primary p-6 lg:p-8 text-white h-full flex flex-col">
							<!-- Decorative accent -->
							<div class="w-12 h-px bg-secondary mb-5"></div>

							<h2 class="font-heading text-xl lg:text-2xl text-secondary mb-1" data-caret="pages::contact::sidebar.heading">{page.sidebar.heading}</h2>
							<p class="font-body text-white/60 text-sm mb-6" data-caret="pages::contact::sidebar.subtitle">{page.sidebar.subtitle}</p>

							<div class="space-y-5">
								<!-- Location -->
								<div class="group">
									<div class="flex items-center gap-3 mb-2">
										<svg class="w-4 h-4 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
											<path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/>
											<path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/>
										</svg>
										<h3 class="font-heading text-secondary text-sm tracking-wide" data-caret="pages::contact::sidebar.location_label">{page.sidebar.location_label}</h3>
									</div>
									<p class="font-body text-white/80 text-sm leading-relaxed pl-7">
										<span data-caret="site::global::contact.address_line1">{site?.contact?.address_line1 ?? '123 Jewelry Lane'}</span><br/>
										<span data-caret="site::global::contact.address_line2">{site?.contact?.address_line2 ?? 'Diamond City, NY 10001'}</span>
									</p>
								</div>

								<!-- Hours -->
								<div class="group">
									<div class="flex items-center gap-3 mb-2">
										<svg class="w-4 h-4 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
											<path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/>
										</svg>
										<h3 class="font-heading text-secondary text-sm tracking-wide" data-caret="pages::contact::sidebar.hours_label">{page.sidebar.hours_label}</h3>
									</div>
									<div class="font-body text-sm pl-7 space-y-1">
										<p class="text-white/80" data-caret="site::global::contact.hours.weekday">{site?.contact?.hours?.weekday ?? 'Mon – Fri: 10am – 7pm'}</p>
										<p class="text-white/80" data-caret="site::global::contact.hours.saturday">{site?.contact?.hours?.saturday ?? 'Saturday: 10am – 5pm'}</p>
										<p class="text-white/50" data-caret="site::global::contact.hours.sunday">{site?.contact?.hours?.sunday ?? 'Sunday: Closed'}</p>
									</div>
								</div>

								<!-- Phone -->
								<div class="group">
									<div class="flex items-center gap-3 mb-2">
										<svg class="w-4 h-4 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
											<path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/>
										</svg>
										<h3 class="font-heading text-secondary text-sm tracking-wide" data-caret="pages::contact::sidebar.phone_label">{page.sidebar.phone_label}</h3>
									</div>
									<a href={`tel:${(site?.contact?.phone ?? '(212) 555-1234').replace(/\D/g, '')}`} class="font-body text-white/80 text-sm hover:text-secondary transition-colors pl-7 block" data-caret="site::global::contact.phone">{site?.contact?.phone ?? '(212) 555-1234'}</a>
								</div>

								<!-- Email -->
								<div class="group">
									<div class="flex items-center gap-3 mb-2">
										<svg class="w-4 h-4 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
											<path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/>
										</svg>
										<h3 class="font-heading text-secondary text-sm tracking-wide" data-caret="pages::contact::sidebar.email_label">{page.sidebar.email_label}</h3>
									</div>
									<a href={`mailto:${site?.contact?.email ?? 'info@sterlingdistrict.com'}`} class="font-body text-white/80 text-sm hover:text-secondary transition-colors pl-7 block" data-caret="site::global::contact.email">{site?.contact?.email ?? 'info@sterlingdistrict.com'}</a>
								</div>
							</div>

							<!-- Call to Action -->
							<div class="mt-auto pt-6 border-t border-white/10">
								<p class="font-body text-white/60 text-xs mb-3" data-caret="pages::contact::sidebar.call_cta_label">{page.sidebar.call_cta_label}</p>
								<a
									href={`tel:${(site?.contact?.phone ?? '(212) 555-1234').replace(/\D/g, '')}`}
									class="inline-flex items-center gap-2 text-secondary text-sm font-medium hover:text-white transition-colors group"
								>
									<span data-caret="pages::contact::sidebar.call_cta_text">{page.sidebar.call_cta_text}</span>
									<svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
										<path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
									</svg>
								</a>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
</Layout>

<style>
	@reference "../styles/base.css";

	/* Form input animations */
	.form-input,
	.form-select {
		@apply transition-all duration-200;
	}

	.form-input:focus,
	.form-select:focus {
		@apply shadow-sm;
	}

	/* Subtle fade in animation for hero elements */
	@keyframes fade-in {
		from {
			opacity: 0;
			transform: translateY(10px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.animate-fade-in {
		animation: fade-in 0.6s ease-out forwards;
	}
</style>

<script>
	const form = document.getElementById('contactForm') as HTMLFormElement | null;
	if (form) {
		const urlParams = new URLSearchParams(window.location.search);
		const productName = urlParams.get('product');
		const serviceSelect = document.getElementById('service') as HTMLSelectElement | null;
		const messageTextarea = document.getElementById('message') as HTMLTextAreaElement | null;
		const charCount = document.getElementById('charCount');
		const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement | null;
		const btnText = document.getElementById('btnText');
		const btnArrow = document.getElementById('btnArrow');
		const btnSpinner = document.getElementById('btnSpinner');
		const successMessage = document.getElementById('successMessage');
		const errorMessage = document.getElementById('errorMessage');
		const errorMessageText = document.getElementById('errorMessageText');
		const endpoint = form.dataset.endpoint?.trim() ?? '';

		if (productName) {
			if (serviceSelect) serviceSelect.value = 'product-inquiry';
			if (messageTextarea) {
				messageTextarea.value = `I'm interested in learning more about the "${productName}". Please provide additional information about availability, pricing, and any customization options.`;
			}
		}

		if (messageTextarea && charCount) {
			const syncCharCount = () => {
				charCount.textContent = messageTextarea.value.length.toString();
			};
			syncCharCount();
			messageTextarea.addEventListener('input', syncCharCount);
		}

		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			successMessage?.classList.add('hidden');
			errorMessage?.classList.add('hidden');

			if (submitBtn) submitBtn.disabled = true;
			if (submitBtn) submitBtn.setAttribute('data-loading', 'true');
			if (btnText) btnText.textContent = 'Sending...';
			if (btnArrow) btnArrow.classList.add('hidden');
			if (btnSpinner) btnSpinner.classList.remove('hidden');

			try {
				if (!endpoint) {
					throw new Error('Contact form endpoint is not configured. Set PUBLIC_CONTACT_FORM_ENDPOINT.');
				}

				const payload = new FormData(form);
				const response = await fetch(endpoint, {
					method: 'POST',
					headers: { Accept: 'application/json' },
					body: payload,
				});

				if (!response.ok) {
					throw new Error('Submission failed. Please try again.');
				}

				form.reset();
				if (charCount) charCount.textContent = '0';
				successMessage?.classList.remove('hidden');
				successMessage?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
			} catch (error) {
				const message = error instanceof Error ? error.message : 'Unable to send message right now.';
				if (errorMessageText) errorMessageText.textContent = message;
				errorMessage?.classList.remove('hidden');
				errorMessage?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
			} finally {
				if (submitBtn) submitBtn.disabled = false;
				if (submitBtn) submitBtn.removeAttribute('data-loading');
				if (btnText) btnText.textContent = 'Send Message';
				if (btnArrow) btnArrow.classList.remove('hidden');
				if (btnSpinner) btnSpinner.classList.add('hidden');
			}
		});
	}
</script>
