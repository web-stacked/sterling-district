---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import { getContentEntry, getContentCollection } from '../lib/content';
import { img } from '../lib/image';
import type { ProductData } from '../content-schema';

const { entry: pageEntry, error: pageError } = await getContentEntry('pages', 'products');
if (pageError || !pageEntry) return Astro.rewrite('/500');
const page = pageEntry.data as Record<string, any>;

const { entries: productEntries } = await getContentCollection<ProductData>('products');
const products = productEntries.map(e => ({ id: e.id, data: e.data }));

const categories = ['all', 'rings', 'necklaces', 'earrings', 'bracelets'] as const;

// Get URL params for filtering
const url = Astro.url;
const categoryParam = url.searchParams.get('category') || 'all';
const sortParam = url.searchParams.get('sort') || 'featured';

// Filter products
let filteredProducts = products;
if (categoryParam !== 'all') {
	filteredProducts = products.filter(p => p.data.category === categoryParam);
}

// Sort products
if (sortParam === 'price-low') {
	filteredProducts = [...filteredProducts].sort((a, b) => a.data.price - b.data.price);
} else if (sortParam === 'price-high') {
	filteredProducts = [...filteredProducts].sort((a, b) => b.data.price - a.data.price);
} else if (sortParam === 'featured') {
	filteredProducts = [...filteredProducts].sort((a, b) => (b.data.featured ? 1 : 0) - (a.data.featured ? 1 : 0));
}
---

<Layout title="Our Collection - Sterling District" darkHero={true}>
	<!-- Hero Section -->
	<section class="relative section-spacing-hero bg-primary overflow-hidden">
		<div class="absolute inset-0">
			<img
				src={img.hero(page.hero.bg_image)}
				alt="Luxury Jewelry Collection"
				class="w-full h-full object-cover opacity-40" data-caret="pages::products::hero.bg_image"
			/>
			<div class="absolute inset-0 bg-gradient-to-b from-primary/70 via-primary/50 to-primary"></div>
		</div>

		<div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-secondary/40 to-transparent"></div>

		<div class="relative z-10 container mx-auto px-4 text-center">
			<div class="flex items-center justify-center gap-6 mb-8">
				<span class="hidden sm:block w-12 h-px bg-gradient-to-r from-transparent to-secondary/60"></span>
				<span class="font-body text-secondary/80 text-[11px] tracking-[0.5em] uppercase" data-caret="pages::products::hero.label">{page.hero.label}</span>
				<span class="hidden sm:block w-12 h-px bg-gradient-to-l from-transparent to-secondary/60"></span>
			</div>
			<h1 class="font-heading text-4xl md:text-5xl lg:text-6xl xl:text-7xl text-white mb-6 font-light">
				<span data-caret="pages::products::hero.headline">{page.hero.headline}</span> <span class="italic text-secondary" data-caret="pages::products::hero.headline_accent">{page.hero.headline_accent}</span>
			</h1>
			<p class="font-body text-white/70 text-lg max-w-2xl mx-auto leading-relaxed" data-caret="pages::products::hero.subtext">
				{page.hero.subtext}
			</p>
		</div>
	</section>

	<!-- Filter Bar -->
	<section class="section-spacing-bar bg-white border-b border-gray-100 md:sticky md:top-[--header-height] z-40 backdrop-blur-xl bg-white/95">
		<div class="container mx-auto px-4">
			<div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
				<!-- Category Tabs -->
				<div class="flex flex-wrap gap-2 md:gap-4">
					{categories.map((category) => (
						<a
							href={category === 'all' ? '/products' : `/products?category=${category}`}
							class={`font-body text-xs tracking-[0.15em] uppercase py-2 px-4 transition-all duration-300 ${
								categoryParam === category
									? 'bg-primary text-white'
									: 'text-gray-500 hover:text-secondary hover:bg-gray-50'
							}`}
						>
							{category === 'all' ? 'All' : category.charAt(0).toUpperCase() + category.slice(1)}
						</a>
					))}
				</div>

				<!-- Sort Dropdown -->
				<div class="flex items-center gap-3">
					<span class="font-body text-xs text-gray-400 tracking-wide uppercase" data-caret="pages::products::sort_by">Sort by</span>
					<div class="relative">
						<select
							id="sort-select"
							class="font-body text-sm text-primary bg-transparent border border-gray-200 px-4 py-2 pr-10 appearance-none cursor-pointer focus:outline-none focus:border-secondary transition-colors"
						>
							<option value="featured" selected={sortParam === 'featured'}>Featured</option>
							<option value="price-low" selected={sortParam === 'price-low'}>Price: Low to High</option>
							<option value="price-high" selected={sortParam === 'price-high'}>Price: High to Low</option>
						</select>
						<svg class="absolute right-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
						</svg>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Products Grid -->
	<section class="section-spacing bg-gray-50">
		<div class="container mx-auto px-4">
			<!-- Results count -->
			<div class="mb-8 flex items-center justify-between">
				<p class="font-body text-sm text-gray-500">
					Showing <span class="text-primary font-medium">{filteredProducts.length}</span> {filteredProducts.length === 1 ? 'piece' : 'pieces'}
					{categoryParam !== 'all' && (
						<span> in <span class="text-secondary">{categoryParam}</span></span>
					)}
				</p>
			</div>

			{filteredProducts.length > 0 ? (
				<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 lg:gap-8">
					{filteredProducts.map((product) => (
						<ProductCard
							id={product.id}
							name={product.data.name}
							price={product.data.price}
							image={product.data.images[0]}
							description={product.data.description}
							slug={product.data.slug}
							featured={product.data.featured}
						/>
					))}
				</div>
			) : (
				<div class="text-center py-16">
					<div class="w-16 h-16 mx-auto mb-6 bg-gray-100 rounded-full flex items-center justify-center">
						<svg class="w-8 h-8 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
							<path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"/>
						</svg>
					</div>
					<h3 class="font-heading text-xl text-primary mb-2" data-caret="pages::products::empty_state.headline">{page.empty_state.headline}</h3>
					<p class="font-body text-gray-500 mb-6" data-caret="pages::products::empty_state.subtext">{page.empty_state.subtext}</p>
					<a href="/products" class="inline-flex items-center text-secondary hover:text-primary transition-colors">
						<span class="text-sm tracking-wide uppercase">View All Products</span>
						<svg class="w-4 h-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
						</svg>
					</a>
				</div>
			)}
		</div>
	</section>

	<!-- CTA Section -->
	<section class="section-spacing-cta bg-primary relative overflow-hidden">
		<div class="absolute inset-0 opacity-10">
			<img src={img.hero(page.cta.bg_image)} alt="" class="w-full h-full object-cover" data-caret="pages::products::cta.bg_image"/>
		</div>
		<div class="absolute inset-0 bg-gradient-to-r from-primary via-primary/95 to-primary"></div>
		<div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-secondary/30 to-transparent"></div>

		<div class="container mx-auto px-4 relative z-10 text-center">
			<span class="label-badge mb-6" data-caret="pages::products::cta.label">{page.cta.label}</span>
			<h2 class="font-heading text-3xl md:text-4xl lg:text-5xl text-white mb-6">
				<span data-caret="pages::products::cta.headline">{page.cta.headline}</span> <span class="italic text-secondary" data-caret="pages::products::cta.headline_accent">{page.cta.headline_accent}</span>
			</h2>
			<p class="font-body text-white/70 text-lg max-w-2xl mx-auto mb-10" data-caret="pages::products::cta.subtext">
				{page.cta.subtext}
			</p>
			<div class="flex flex-col sm:flex-row gap-4 justify-center">
				<a
					href="/contact"
					class="inline-flex items-center justify-center px-10 py-5 bg-white text-primary text-xs tracking-[0.2em] uppercase font-medium hover:bg-secondary hover:text-white transition-all duration-500" data-caret="pages::products::cta.cta_primary"
				>
					{page.cta.cta_primary}
				</a>
				<a
					href="/services#custom"
					class="inline-flex items-center justify-center px-10 py-5 border-2 border-white/30 text-white text-xs tracking-[0.2em] uppercase font-medium hover:bg-white hover:text-primary transition-all duration-500" data-caret="pages::products::cta.cta_secondary"
				>
					{page.cta.cta_secondary}
				</a>
			</div>
		</div>
	</section>
</Layout>

<script>
	const sortSelect = document.getElementById('sort-select') as HTMLSelectElement | null;
	if (sortSelect) {
		const urlParams = new URLSearchParams(window.location.search);
		sortSelect.value = urlParams.get('sort') || 'featured';

		sortSelect.addEventListener('change', () => {
			const url = new URL(window.location.href);
			if (sortSelect.value === 'featured') {
				url.searchParams.delete('sort');
			} else {
				url.searchParams.set('sort', sortSelect.value);
			}
			window.location.href = url.toString();
		});
	}
</script>
