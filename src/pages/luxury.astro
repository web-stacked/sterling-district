---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/HeroSection.astro';
import FaqSection from '../components/FaqSection.astro';
import TestimonialSection from '../components/TestimonialSection.astro';
import { getContentEntry, getContentCollection } from '../lib/content';
import { img } from '../lib/image';
import { linkify } from '../lib/linkify';
import type { ProductData, TestimonialData, FaqData } from '../content-schema';

const { entry: luxuryEntry, error: luxuryError } = await getContentEntry('pages', 'luxury');
if (luxuryError || !luxuryEntry) return Astro.rewrite('/500');
const luxury = luxuryEntry.data as Record<string, any>;

const { entries: productEntries } = await getContentCollection<ProductData>('products');
const featuredProducts = productEntries.filter(p => p.data.featured).slice(0, 3);

const { entries: faqEntries } = await getContentCollection<FaqData>('faqs');
const faqs = faqEntries.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

const { entries: testimonialEntries } = await getContentCollection<TestimonialData>('testimonials');
const testimonials = testimonialEntries.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
---

<Layout title="Sterling District - Luxury Jewelry" darkHero={true}>
	<HeroSection pageId="luxury" hero={luxury.hero} />

	<!-- Trust Badges Bar -->
	<section class="py-8 bg-white border-y border-gray-100">
		<div class="container mx-auto px-4">
			<div class="flex flex-wrap justify-center gap-8 md:gap-16">
				{(luxury.trust_badges as string[]).map((badge: string, i: number) => (
					<div class="flex items-center gap-3 text-gray-600 group">
						<svg class="w-5 h-5 text-secondary group-hover:scale-110 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
							{i === 0 && <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/>}
							{i === 1 && <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.125-.504 1.125-1.125v-2.25m-17.25 4.5V7.5A1.5 1.5 0 014.875 6h8.25m7.5 9V13.5a.75.75 0 01.75-.75h1.5a.75.75 0 01.75.75v3.75M14.25 6h3.375a1.125 1.125 0 011.125 1.125v3.75"/>}
							{i === 2 && <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 18.75h-9m9 0a3 3 0 013 3h-15a3 3 0 013-3m9 0v-3.375c0-.621-.503-1.125-1.125-1.125h-.871M7.5 18.75v-3.375c0-.621.504-1.125 1.125-1.125h.872m5.007 0H9.497m5.007 0a7.454 7.454 0 01-.982-3.172M9.497 14.25a7.454 7.454 0 00.981-3.172M5.25 4.236c-.982.143-1.954.317-2.916.52A6.003 6.003 0 007.73 9.728M5.25 4.236V4.5c0 2.108.966 3.99 2.48 5.228M5.25 4.236V2.721C7.456 2.41 9.71 2.25 12 2.25c2.291 0 4.545.16 6.75.47v1.516M7.73 9.728a6.726 6.726 0 002.748 1.35m8.272-6.842V4.5c0 2.108-.966 3.99-2.48 5.228m2.48-5.492a46.32 46.32 0 012.916.52 6.003 6.003 0 01-5.395 4.972m0 0a6.726 6.726 0 01-2.749 1.35m0 0a6.772 6.772 0 01-3.044 0"/>}
							{i === 3 && <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z"/>}
						</svg>
						<span class="font-body text-xs tracking-[0.15em] uppercase" data-caret={`pages::luxury::trust_badges.${i}`}>{badge}</span>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- Featured Products Section -->
	<section class="py-24 bg-white relative overflow-hidden">
		<div class="container mx-auto px-4">
			<div class="text-center mb-16">
				<span class="label-badge" data-caret="pages::luxury::featured.label">{luxury.featured.label}</span>
				<h2 class="font-heading text-4xl md:text-5xl text-primary mb-6" data-caret="pages::luxury::featured.headline">{luxury.featured.headline}</h2>
				<p class="font-body text-gray-600 max-w-2xl mx-auto" data-caret="pages::luxury::featured.subtext">
					{luxury.featured.subtext}
				</p>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
				{featuredProducts.map((p) => (
					<a href={'/products/' + p.data.slug} class="group block">
						<div class="relative aspect-square overflow-hidden bg-gray-50 mb-6">
							<img
								src={img.card(p.data.images[0])}
								alt={p.data.name}
								class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700" data-caret={`products::${p.id}::images.0`}
							/>
							<div class="absolute inset-0 bg-black/0 group-hover:bg-black/10 transition-colors duration-300"></div>
							<span class="absolute top-4 left-4 bg-secondary text-white text-[10px] tracking-[0.15em] uppercase px-3 py-1.5">
								Featured
							</span>
						</div>
						<h3 class="font-heading text-xl text-primary mb-2 group-hover:text-secondary transition-colors" data-caret={`products::${p.id}::name`}>{p.data.name}</h3>
						<div class="flex items-center gap-3">
							<span class="font-body text-secondary font-medium">{'$' + p.data.price.toLocaleString()}</span>
						</div>
						<span class="inline-flex items-center text-primary/70 text-sm mt-3 group-hover:text-secondary transition-colors">
							View Details
							<svg class="w-4 h-4 ml-2 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
							</svg>
						</span>
					</a>
				))}
			</div>

			<div class="text-center">
				<a href="/products" class="inline-flex items-center justify-center px-8 py-4 border border-primary text-primary text-xs tracking-[0.2em] uppercase hover:bg-primary hover:text-white transition-all duration-500" data-caret="pages::luxury::featured.cta">
					{luxury.featured.cta}
				</a>
			</div>
		</div>
	</section>

	<!-- Diamond Craftsmanship Section -->
	<section class="py-24 bg-primary text-white relative overflow-hidden">
		<div class="absolute inset-0 opacity-10">
			<img
				src={img.hero(luxury.craftsmanship.bg_image)}
				alt="Diamond macro"
				class="w-full h-full object-cover" data-caret="pages::luxury::craftsmanship.bg_image"
			/>
		</div>

		<div class="container mx-auto px-4 relative z-10">
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
				<div>
					<span class="label-badge" data-caret="pages::luxury::craftsmanship.label">{luxury.craftsmanship.label}</span>
					<h2 class="font-heading text-4xl md:text-5xl text-white mb-6">
						<span data-caret="pages::luxury::craftsmanship.headline">{luxury.craftsmanship.headline}</span> <span class="italic text-secondary" data-caret="pages::luxury::craftsmanship.headline_accent">{luxury.craftsmanship.headline_accent}</span>
					</h2>
					<p class="font-body text-white/80 text-lg mb-8 leading-relaxed" data-caret="pages::luxury::craftsmanship.description">
						{luxury.craftsmanship.description}
					</p>
					<a href="/services" class="inline-flex items-center text-secondary hover:text-white transition-colors">
						<span class="text-sm tracking-[0.15em] uppercase" data-caret="pages::luxury::craftsmanship.cta">{luxury.craftsmanship.cta}</span>
						<svg class="w-4 h-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
						</svg>
					</a>
				</div>

				<div class="grid grid-cols-2 gap-6">
					{(luxury.craftsmanship.stats as any[]).map((stat: any, i: number) => (
						<div class="bg-white/5 backdrop-blur-sm border border-white/10 p-8 text-center">
							<div class="font-heading text-5xl text-secondary mb-2" data-caret={`pages::luxury::craftsmanship.stats.${i}.value`}>{stat.value}</div>
							<div class="font-body text-xs tracking-[0.15em] uppercase text-white/70" data-caret={`pages::luxury::craftsmanship.stats.${i}.label`}>{stat.label}</div>
						</div>
					))}
				</div>
			</div>
		</div>
	</section>

	<!-- Why Choose Us Section -->
	<section class="py-24 bg-gray-50">
		<div class="container mx-auto px-4">
			<div class="text-center mb-16">
				<span class="label-badge" data-caret="pages::luxury::why_us.label">{luxury.why_us.label}</span>
				<h2 class="font-heading text-4xl md:text-5xl text-primary mb-6" data-caret="pages::luxury::why_us.headline">{luxury.why_us.headline}</h2>
				<p class="font-body text-gray-600 max-w-2xl mx-auto" data-caret="pages::luxury::why_us.subtext">
					{luxury.why_us.subtext}
				</p>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
				{(luxury.why_us.features as any[]).map((feature: any, i: number) => (
					<div class="bg-white p-8 text-center group hover:shadow-xl transition-shadow duration-300">
						<div class="w-16 h-16 mx-auto mb-6 bg-secondary/10 rounded-full flex items-center justify-center group-hover:bg-secondary/20 transition-colors">
							{i === 0 && (
								<svg class="w-8 h-8 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
									<path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 00-2.456 2.456zM16.894 20.567L16.5 21.75l-.394-1.183a2.25 2.25 0 00-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 001.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 001.423 1.423l1.183.394-1.183.394a2.25 2.25 0 00-1.423 1.423z"/>
								</svg>
							)}
							{i === 1 && (
								<svg class="w-8 h-8 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
									<path stroke-linecap="round" stroke-linejoin="round" d="M12.75 3.03v.568c0 .334.148.65.405.864l1.068.89c.442.369.535 1.01.216 1.49l-.51.766a2.25 2.25 0 01-1.161.886l-.143.048a1.107 1.107 0 00-.57 1.664c.369.555.169 1.307-.427 1.605L9 13.125l.423 1.059a.956.956 0 01-1.652.928l-.679-.906a1.125 1.125 0 00-1.906.172L4.5 15.75l-.612.153M12.75 3.031a9 9 0 00-8.862 12.872M12.75 3.031a9 9 0 016.69 14.036m0 0l-.177-.529A2.25 2.25 0 0017.128 15H16.5l-.324-.324a1.453 1.453 0 00-2.328.377l-.036.073a1.586 1.586 0 01-.982.816l-.99.282c-.55.157-.894.702-.8 1.267l.073.438c.08.474.49.821.97.821.846 0 1.598.542 1.865 1.345l.215.643m5.276-3.67a9.012 9.012 0 01-5.276 3.67m0 0a9 9 0 01-10.275-4.835M15.75 9c0 .896-.393 1.7-1.016 2.25"/>
								</svg>
							)}
							{i === 2 && (
								<svg class="w-8 h-8 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
									<path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"/>
								</svg>
							)}
							{i === 3 && (
								<svg class="w-8 h-8 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
									<path stroke-linecap="round" stroke-linejoin="round" d="M21 11.25v8.25a1.5 1.5 0 01-1.5 1.5H5.25a1.5 1.5 0 01-1.5-1.5v-8.25M12 4.875A2.625 2.625 0 109.375 7.5H12m0-2.625V7.5m0-2.625A2.625 2.625 0 1114.625 7.5H12m0 0V21m-8.625-9.75h18c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125h-18c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z"/>
								</svg>
							)}
						</div>
						<h3 class="font-heading text-xl text-primary mb-3" data-caret={`pages::luxury::why_us.features.${i}.title`}>{feature.title}</h3>
						<p class="font-body text-gray-600 text-sm leading-relaxed" data-caret={`pages::luxury::why_us.features.${i}.desc`} set:html={linkify(feature.desc)} />
					</div>
				))}
			</div>
		</div>
	</section>

	<FaqSection pageId="luxury" label={luxury.faq.label} headline={luxury.faq.headline} faqs={faqs} />

	<TestimonialSection
		pageId="luxury"
		label={luxury.testimonials.label}
		headline={luxury.testimonials.headline}
		subtext={luxury.testimonials.subtext}
		style={luxury.testimonials.style ?? 'featured'}
		testimonials={testimonials}
	/>

	<!-- CTA Section -->
	<section class="py-24 bg-primary relative overflow-hidden">
		<div class="absolute inset-0 opacity-20">
			<img
				src={img.hero(luxury.cta.bg_image)}
				alt="Jewelry background"
				class="w-full h-full object-cover" data-caret="pages::luxury::cta.bg_image"
			/>
		</div>
		<div class="absolute inset-0 bg-gradient-to-r from-primary via-primary/95 to-primary"></div>

		<div class="container mx-auto px-4 relative z-10 text-center">
			<span class="label-badge" data-caret="pages::luxury::cta.label">{luxury.cta.label}</span>
			<h2 class="font-heading text-4xl md:text-5xl lg:text-6xl text-white mb-6">
				<span data-caret="pages::luxury::cta.headline">{luxury.cta.headline}</span> <span class="italic text-secondary" data-caret="pages::luxury::cta.headline_accent">{luxury.cta.headline_accent}</span>
			</h2>
			<p class="font-body text-white/80 text-lg max-w-2xl mx-auto mb-12" data-caret="pages::luxury::cta.subtext">
				{luxury.cta.subtext}
			</p>

			<div class="flex flex-col sm:flex-row gap-4 justify-center">
				<a href="/contact" class="inline-flex items-center justify-center px-8 py-4 bg-white text-primary text-xs tracking-[0.2em] uppercase hover:bg-secondary hover:text-white transition-all duration-500" data-caret="pages::luxury::cta.cta_primary">
					{luxury.cta.cta_primary}
				</a>
				<a href="/products" class="inline-flex items-center justify-center px-8 py-4 border border-white/40 text-white text-xs tracking-[0.2em] uppercase hover:bg-white hover:text-primary transition-all duration-500" data-caret="pages::luxury::cta.cta_secondary">
					{luxury.cta.cta_secondary}
				</a>
			</div>
		</div>
	</section>
</Layout>
