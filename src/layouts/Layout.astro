---
import '../styles/base.css';
import { getContentEntry } from '../lib/content';
import type { SiteGlobalData } from '../content-schema';

interface Props {
	title?: string;
	darkHero?: boolean;
}

const { title = "Sterling District - Fine Jewelry & Services", darkHero = false } = Astro.props;
const currentPath = Astro.url.pathname;

// Load site-wide content — layout must always render, so fallback gracefully
const { entry: siteEntry } = await getContentEntry<SiteGlobalData>('site', 'global');
const site = siteEntry?.data;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Sterling District - Fine Jewelry & Expert Diamond Services" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="bg-white text-gray-900 font-body antialiased" data-dark-hero={darkHero}>
		<!-- Elegant Header with Scroll Effect -->
		<header
			id="main-header"
			class={`fixed top-0 left-0 right-0 z-50 transition-all duration-500 ${darkHero ? 'header-transparent' : 'header-solid'}`}
		>
			<div class="container mx-auto px-4 sm:px-6 lg:px-8">
				<div class="flex justify-between items-center py-4 lg:py-5">
					<!-- Logo -->
					<a href="/" class="logo-text text-2xl font-heading font-bold flex items-center gap-2 transition-colors duration-300">
						<svg class="w-8 h-8 text-secondary" viewBox="0 0 24 24" fill="currentColor">
							<path d="M12 2L2 9l10 13 10-13L12 2zm0 3.84L18.26 9 12 17.65 5.74 9 12 5.84z"/>
						</svg>
						<span data-caret="site::global::company_name">{site?.company_name ?? 'Sterling District'}</span>
					</a>

					<!-- Desktop Navigation -->
					<nav class="hidden md:flex items-center space-x-8">
						{(site?.nav ?? [{ label: 'Home', href: '/' }, { label: 'Services', href: '/services' }, { label: 'Products', href: '/products' }]).map((item, i) => (
							<a href={item.href} class="nav-link" data-caret={`site::global::nav.${i}.label`}>{item.label}</a>
						))}
						<a href="/contact" class="nav-link-cta">
							<span data-caret="site::global::nav_cta">{site?.nav_cta ?? 'Book Consultation'}</span>
						</a>
					</nav>

					<!-- Mobile Menu Button -->
					<button id="mobile-menu-button" class="md:hidden mobile-menu-btn p-2 rounded-lg transition-colors min-w-[44px] min-h-[44px] flex items-center justify-center" aria-label="Open menu">
						<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
						</svg>
					</button>
				</div>
			</div>
		</header>

		<!-- Mobile Navigation Overlay - OUTSIDE header for proper z-index stacking -->
		<div id="mobile-menu" class="mobile-menu-overlay fixed inset-0 bg-primary z-[100] hidden opacity-0 transition-opacity duration-300">
			<div class="flex flex-col h-full">
				<div class="flex justify-between items-center px-6 py-5 border-b border-white/10">
					<a href="/" class="text-2xl font-heading font-bold text-white flex items-center gap-2">
						<svg class="w-8 h-8 text-secondary" viewBox="0 0 24 24" fill="currentColor">
							<path d="M12 2L2 9l10 13 10-13L12 2zm0 3.84L18.26 9 12 17.65 5.74 9 12 5.84z"/>
						</svg>
						<span>{site?.company_name ?? 'Sterling District'}</span>
					</a>
					<button id="close-menu" class="text-white p-2 hover:text-secondary transition-colors min-w-[44px] min-h-[44px] flex items-center justify-center" aria-label="Close menu">
						<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
						</svg>
					</button>
				</div>
				<nav class="flex-1 flex flex-col justify-center items-center space-y-8 p-8">
					<a href="/" class={`mobile-nav-link text-3xl font-heading transition-colors ${currentPath === '/' ? 'text-secondary' : 'text-white hover:text-secondary'}`} aria-current={currentPath === '/' ? 'page' : undefined} data-caret="site::layout::home">Home</a>
					<a href="/services" class={`mobile-nav-link text-3xl font-heading transition-colors ${currentPath === '/services' || currentPath === '/services/' ? 'text-secondary' : 'text-white hover:text-secondary'}`} aria-current={currentPath === '/services' || currentPath === '/services/' ? 'page' : undefined} data-caret="site::layout::services">Services</a>
					<a href="/products" class={`mobile-nav-link text-3xl font-heading transition-colors ${currentPath.startsWith('/products') ? 'text-secondary' : 'text-white hover:text-secondary'}`} aria-current={currentPath.startsWith('/products') ? 'page' : undefined} data-caret="site::layout::products">Products</a>
					<a href="/contact" class={`mobile-nav-link text-3xl font-heading transition-colors ${currentPath === '/contact' || currentPath === '/contact/' ? 'text-secondary' : 'text-white hover:text-secondary'}`} aria-current={currentPath === '/contact' || currentPath === '/contact/' ? 'page' : undefined} data-caret="site::layout::contact">Contact</a>
				</nav>
				<div class="p-8 border-t border-white/10 text-center">
					<a href="/contact" class="inline-flex items-center justify-center px-8 py-4 bg-secondary text-white text-sm tracking-wider uppercase hover:bg-secondary/90 transition-colors" data-caret="site::layout::book_consultation">
						Book Consultation
					</a>
				</div>
			</div>
		</div>

		<main class={darkHero ? '' : 'pt-24'}>
			<slot />
		</main>

		<!-- Back to Top Button -->
		<button
			id="back-to-top"
			class="fixed bottom-6 right-6 w-12 h-12 bg-secondary text-white rounded-full shadow-lg opacity-0 pointer-events-none transition-all duration-300 hover:bg-secondary/90 hover:scale-110 z-40 flex items-center justify-center"
			aria-label="Back to top"
		>
			<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
				<path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7"/>
			</svg>
		</button>


		<!-- Enhanced Footer -->
		<footer class="bg-primary text-white relative overflow-hidden">
			<!-- Decorative Elements -->
			<div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-secondary/30 to-transparent"></div>
			<div class="absolute top-20 right-10 opacity-5">
				<svg class="w-64 h-64 text-secondary" viewBox="0 0 24 24" fill="currentColor">
					<path d="M12 2L2 9l10 13 10-13L12 2zm0 3.84L18.26 9 12 17.65 5.74 9 12 5.84z"/>
				</svg>
			</div>

			<div class="container mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-20 relative z-10">
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 lg:gap-16">
					<!-- Company Info -->
					<div class="lg:col-span-1">
						<div class="flex items-center gap-2 mb-6">
							<svg class="w-8 h-8 text-secondary" viewBox="0 0 24 24" fill="currentColor">
								<path d="M12 2L2 9l10 13 10-13L12 2zm0 3.84L18.26 9 12 17.65 5.74 9 12 5.84z"/>
							</svg>
							<span class="text-2xl font-heading font-bold">{site?.company_name ?? 'Sterling District'}</span>
						</div>
						<p class="mb-6 text-gray-300 leading-relaxed" data-caret="site::global::tagline">{site?.tagline ?? 'Your trusted partner for fine jewelry services, restoration, and custom designs since 1947.'}</p>
						<div class="flex space-x-4">
							<a href={site?.social?.instagram ?? '#'} aria-label="Instagram" class="w-10 h-10 rounded-full bg-white/5 flex items-center justify-center text-gray-300 hover:bg-secondary hover:text-white transition-all duration-300" target="_blank" rel="noopener noreferrer">
								<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 1.802a3.333 3.333 0 100 6.666 3.333 3.333 0 000-6.666zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z" clip-rule="evenodd"></path></svg>
							</a>
							<a href={site?.social?.tiktok ?? '#'} aria-label="TikTok" class="w-10 h-10 rounded-full bg-white/5 flex items-center justify-center text-gray-300 hover:bg-secondary hover:text-white transition-all duration-300" target="_blank" rel="noopener noreferrer">
								<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1v-3.5a6.37 6.37 0 00-.79-.05A6.34 6.34 0 003.15 15.2a6.34 6.34 0 0010.86 4.46V13.2a8.16 8.16 0 005.58 2.17v-3.45a4.85 4.85 0 01-3.77-1.46V6.69h3.77z"/></svg>
							</a>
						</div>
					</div>

					<!-- Contact Info -->
					<div>
						<h3 class="text-lg font-heading font-semibold mb-6 flex items-center gap-2" data-caret="site::layout::contact_us" data-caret-rich>
							<span class="w-8 h-px bg-secondary"></span>
							Contact Us
						</h3>
						<ul class="space-y-4 text-gray-300">
							<li class="flex items-start gap-3">
								<svg class="w-5 h-5 mt-0.5 text-secondary flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
								<span class="text-sm leading-relaxed"><span data-caret="site::global::contact.address_line1">{site?.contact?.address_line1 ?? '123 Jewelry Lane'}</span><br/><span data-caret="site::global::contact.address_line2">{site?.contact?.address_line2 ?? 'Diamond City, NY 10001'}</span></span>
							</li>
							<li class="flex items-center gap-3">
								<svg class="w-5 h-5 text-secondary flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
								<span class="text-sm" data-caret="site::global::contact.phone">{site?.contact?.phone ?? '(212) 555-1234'}</span>
							</li>
							<li class="flex items-center gap-3">
								<svg class="w-5 h-5 text-secondary flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
								<span class="text-sm" data-caret="site::global::contact.email">{site?.contact?.email ?? 'info@sterlingdistrict.com'}</span>
							</li>
						</ul>
					</div>

					<!-- Quick Links -->
					<div>
						<h3 class="text-lg font-heading font-semibold mb-6 flex items-center gap-2" data-caret="site::layout::quick_links" data-caret-rich>
							<span class="w-8 h-px bg-secondary"></span>
							Quick Links
						</h3>
						<ul class="space-y-3 text-gray-300">
							{(site?.footer_links ?? [
								{ label: 'Jewelry Repair', href: '/services' },
								{ label: 'Custom Design', href: '/services' },
								{ label: 'Diamond Services', href: '/services' },
								{ label: 'Shop Collection', href: '/products' },
								{ label: 'Book Consultation', href: '/contact' },
							]).map((link, i) => (
								<li><a href={link.href} class="text-sm hover:text-secondary transition-colors inline-flex items-center gap-2 group"><span class="w-0 group-hover:w-2 h-px bg-secondary transition-all duration-300"></span><span data-caret={`site::global::footer_links.${i}.label`}>{link.label}</span></a></li>
							))}
						</ul>
					</div>

					<!-- Newsletter -->
					<div>
						<h3 class="text-lg font-heading font-semibold mb-6 flex items-center gap-2">
							<span class="w-8 h-px bg-secondary"></span>
							<span data-caret="site::global::newsletter.heading">{site?.newsletter?.heading ?? 'Stay Updated'}</span>
						</h3>
						<p class="mb-4 text-gray-300 text-sm leading-relaxed" data-caret="site::global::newsletter.subtext">{site?.newsletter?.subtext ?? 'Subscribe to receive updates on new products and exclusive offers.'}</p>
						<form class="space-y-3">
							<div class="relative">
								<input type="email" placeholder={site?.newsletter?.placeholder ?? 'Your email address'} class="w-full px-4 py-3 rounded-none bg-white/5 border border-white/10 text-white placeholder-gray-500 focus:outline-none focus:border-secondary transition-colors text-sm">
							</div>
							<button type="submit" class="w-full bg-secondary hover:bg-secondary/90 text-white px-4 py-3 text-sm tracking-wider uppercase transition-colors" data-caret="site::global::newsletter.button">
								{site?.newsletter?.button ?? 'Subscribe'}
							</button>
						</form>
					</div>
				</div>

				<div class="mt-16 pt-8 border-t border-white/10 flex flex-col md:flex-row justify-between items-center gap-4">
					<p class="text-gray-400 text-sm">&copy; {new Date().getFullYear()} {site?.company_name ?? 'Sterling District'}. All rights reserved.</p>
					<div class="flex items-center space-x-6 text-sm text-gray-400">
						{(site?.footer_bottom_links ?? [
							{ label: 'Contact Us', href: '/contact' },
							{ label: 'Our Services', href: '/services' },
						]).map((link, i) => (
							<a href={link.href} class="hover:text-secondary transition-colors" data-caret={`site::global::footer_bottom_links.${i}.label`}>{link.label}</a>
						))}
					</div>
				</div>
			</div>
		</footer>

		<!-- Scripts -->
		<script>
			const header = document.getElementById('main-header');
			const hasDarkHero = document.body.dataset.darkHero === 'true';
			const backToTopBtn = document.getElementById('back-to-top');
			const mobileMenuButton = document.getElementById('mobile-menu-button');
			const mobileMenu = document.getElementById('mobile-menu');
			const closeMenuButton = document.getElementById('close-menu');

			const updateHeader = () => {
				if (!hasDarkHero || window.scrollY > 100) {
					header?.classList.remove('header-transparent');
					header?.classList.add('header-solid');
				} else {
					header?.classList.add('header-transparent');
					header?.classList.remove('header-solid');
				}
			};

			const openMobileMenu = () => {
				mobileMenu?.classList.remove('hidden');
				setTimeout(() => {
					mobileMenu?.classList.add('opacity-100');
					mobileMenu?.classList.remove('opacity-0');
				}, 10);
				document.body.style.overflow = 'hidden';
			};

			const closeMobileMenu = () => {
				mobileMenu?.classList.add('opacity-0');
				mobileMenu?.classList.remove('opacity-100');
				setTimeout(() => {
					mobileMenu?.classList.add('hidden');
				}, 300);
				document.body.style.overflow = '';
			};

			const updateBackToTop = () => {
				if (!backToTopBtn) return;
				if (window.scrollY > 600) {
					backToTopBtn.classList.remove('opacity-0', 'pointer-events-none');
				} else {
					backToTopBtn.classList.add('opacity-0', 'pointer-events-none');
				}
			};

			window.addEventListener('scroll', updateHeader, { passive: true });
			window.addEventListener('scroll', updateBackToTop, { passive: true });

			mobileMenuButton?.addEventListener('click', openMobileMenu);
			closeMenuButton?.addEventListener('click', closeMobileMenu);
			mobileMenu?.querySelectorAll('a').forEach((link) => {
				link.addEventListener('click', closeMobileMenu);
			});

			backToTopBtn?.addEventListener('click', () => {
				window.scrollTo({ top: 0, behavior: 'smooth' });
			});

			const observer = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						if (entry.isIntersecting) {
							entry.target.classList.add('revealed');
							observer.unobserve(entry.target);
						}
					});
				},
				{ root: null, rootMargin: '0px', threshold: 0.1 }
			);

			document.querySelectorAll('.reveal-on-scroll').forEach((el) => observer.observe(el));

			updateHeader();
			updateBackToTop();
		</script>
	</body>
</html>

<style is:global>
	@reference "../styles/base.css";

	/* Header States */
	.header-transparent {
		@apply bg-transparent;
	}

	.header-transparent .logo-text {
		@apply text-white;
	}

	.header-transparent .nav-link {
		@apply text-white/90 hover:text-secondary;
	}

	.header-transparent .nav-link-cta {
		@apply border border-white/30 text-white px-5 py-2 text-sm tracking-wider uppercase hover:bg-white hover:text-primary transition-all duration-300;
	}

	.header-transparent .mobile-menu-btn {
		@apply text-white hover:bg-white/10;
	}

	.header-solid {
		@apply bg-white/95 backdrop-blur-lg shadow-sm;
	}

	.header-solid .logo-text {
		@apply text-primary;
	}

	.header-solid .nav-link {
		@apply text-gray-700 hover:text-secondary;
	}

	.header-solid .nav-link-cta {
		@apply border border-secondary text-secondary px-5 py-2 text-sm tracking-wider uppercase hover:bg-secondary hover:text-white transition-all duration-300;
	}

	.header-solid .mobile-menu-btn {
		@apply text-gray-700 hover:bg-gray-100;
	}

	/* Navigation Links */
	.nav-link {
		@apply relative font-medium text-sm tracking-wide transition-colors duration-300;
	}

	.nav-link::after {
		content: '';
		@apply absolute -bottom-1 left-0 w-0 h-0.5 bg-secondary transition-all duration-300;
	}

	.nav-link:hover::after {
		@apply w-full;
	}

	/* Scroll Reveal Animation */
	.reveal-on-scroll {
		@apply opacity-0 translate-y-8 transition-all duration-700 ease-out;
	}

	.reveal-on-scroll.revealed {
		@apply opacity-100 translate-y-0;
	}

	/* Staggered animations */
	.reveal-on-scroll[data-delay="1"] { transition-delay: 100ms; }
	.reveal-on-scroll[data-delay="2"] { transition-delay: 200ms; }
	.reveal-on-scroll[data-delay="3"] { transition-delay: 300ms; }
	.reveal-on-scroll[data-delay="4"] { transition-delay: 400ms; }
</style>
