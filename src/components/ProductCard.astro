---
import { img } from '../lib/image';
import { linkify } from '../lib/linkify';

interface Props {
  id?: string;
  name: string;
  price: number;
  image: string;
  description?: string;
  slug: string;
  featured?: boolean;
}

const { id, name, price, image, description, slug, featured = false } = Astro.props;
const caretPrefix = id ? `products::${id}` : undefined;
---

<a href={`/products/${slug}`} class="group block h-full">
  <div class="relative bg-gray-50 overflow-hidden shadow-sm hover:shadow-xl transition-all duration-500 h-full flex flex-col border border-gray-100 hover:border-secondary/40">
    <!-- Image -->
    <div class="relative w-full overflow-hidden flex-shrink-0 pb-[100%]">
      <img
        src={img.card(image)}
        alt={name}
        class="absolute inset-0 w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-700 ease-out"
        loading="lazy"
        data-caret={caretPrefix ? `${caretPrefix}::images.0` : undefined}
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/30 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>

      {featured && (
        <span class="absolute top-4 left-4 bg-secondary text-white text-[10px] tracking-[0.2em] uppercase px-4 py-2 shadow-lg">
          Featured
        </span>
      )}

      <!-- Quick View Overlay -->
      <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300">
        <span class="bg-white text-primary px-6 py-3 text-xs tracking-widest uppercase font-medium shadow-xl transform translate-y-4 group-hover:translate-y-0 transition-transform duration-300" data-caret="components::product-card::view_details">
          View Details
        </span>
      </div>
    </div>

    <!-- Content -->
    <div class="p-6 bg-white flex-grow flex flex-col">
      <h3
        class="font-heading text-lg text-primary mb-2 group-hover:text-secondary transition-colors duration-300 line-clamp-2"
        data-caret={caretPrefix ? `${caretPrefix}::name` : undefined}
      >
        {name}
      </h3>

      {description && (
        <p
          class="font-body text-gray-500 text-sm line-clamp-2 mb-4 flex-grow"
          data-caret={caretPrefix ? `${caretPrefix}::description` : undefined}
          set:html={linkify(description)}
        />
      )}

      <div class="flex items-center justify-between mt-auto pt-4 border-t border-gray-100">
        <span
          class="font-body text-secondary text-lg font-semibold"
          data-caret={caretPrefix ? `${caretPrefix}::price` : undefined}
        >
          ${price.toLocaleString()}
        </span>
        <span class="inline-flex items-center text-primary/50 text-xs group-hover:text-secondary transition-colors">
          <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
        </span>
      </div>
    </div>
  </div>
</a>
