---
import { img } from '../lib/image';

interface Props {
	pageId: string;
	hero: {
		bg_image: string;
		badge: string;
		headline: string;
		headline_accent: string;
		subtext: string;
		cta_primary: string;
		cta_secondary: string;
	};
}

const { pageId, hero } = Astro.props;
---

<section class="relative min-h-screen bg-primary overflow-hidden">
	<div class="absolute inset-0">
		<img
			src={img.hero(hero.bg_image)}
			alt="Luxury Diamond Jewelry"
			class="w-full h-full object-cover opacity-50 hero-bg-zoom" data-caret={`pages::${pageId}::hero.bg_image`}
		/>
		<div class="absolute inset-0 bg-gradient-to-b from-primary/60 via-primary/40 to-primary/95"></div>
		<div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,transparent_0%,rgba(22,36,71,0.4)_100%)]"></div>
	</div>

	<div class="hero-grain absolute inset-0 pointer-events-none opacity-[0.03]"></div>
	<div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-secondary/40 to-transparent"></div>

	<div class="relative z-10 min-h-screen flex flex-col justify-center items-center px-4 text-center">
		<div class="hero-content max-w-5xl">
			<div class="hero-subtitle flex items-center justify-center gap-6 mb-10">
				<span class="hidden sm:block w-12 h-px bg-gradient-to-r from-transparent to-secondary/60"></span>
				<p class="font-body text-secondary/80 text-[11px] tracking-[0.5em] uppercase" data-caret={`pages::${pageId}::hero.badge`}>
					{hero.badge}
				</p>
				<span class="hidden sm:block w-12 h-px bg-gradient-to-l from-transparent to-secondary/60"></span>
			</div>

			<h1 class="hero-title font-heading text-white text-4xl sm:text-5xl md:text-6xl lg:text-7xl xl:text-8xl font-extralight tracking-wide mb-2 leading-[1.1]" data-caret={`pages::${pageId}::hero.headline`}>
				{hero.headline}
			</h1>
			<h2 class="hero-title-accent font-heading text-secondary text-4xl sm:text-5xl md:text-6xl lg:text-7xl xl:text-8xl italic font-light mb-12" data-caret={`pages::${pageId}::hero.headline_accent`}>
				{hero.headline_accent}
			</h2>
			<p class="hero-description font-body text-white/60 text-base md:text-lg max-w-xl mx-auto mb-16 font-light tracking-wide leading-relaxed" data-caret={`pages::${pageId}::hero.subtext`}>
				{hero.subtext}
			</p>

			<div class="hero-cta flex flex-col sm:flex-row gap-5 justify-center">
				<a href="/products" class="group relative inline-flex items-center justify-center px-12 py-4 bg-white text-primary text-[11px] tracking-[0.25em] uppercase font-medium overflow-hidden transition-all duration-500 hover:shadow-[0_10px_40px_rgba(212,175,55,0.3)]">
					<span class="relative z-10 flex items-center">
						<span data-caret={`pages::${pageId}::hero.cta_primary`}>{hero.cta_primary}</span>
						<svg class="w-4 h-4 ml-3 transform group-hover:translate-x-1 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
						</svg>
					</span>
					<span class="absolute inset-0 bg-secondary transform origin-left scale-x-0 group-hover:scale-x-100 transition-transform duration-500"></span>
					<span class="absolute inset-0 z-10 flex items-center justify-center text-white opacity-0 group-hover:opacity-100 transition-opacity duration-500 delay-100">
						<span class="flex items-center">
							{hero.cta_primary}
							<svg class="w-4 h-4 ml-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
							</svg>
						</span>
					</span>
				</a>
				<a href="/contact" class="group inline-flex items-center justify-center px-12 py-4 border border-white/20 text-white/90 text-[11px] tracking-[0.25em] uppercase font-medium hover:border-secondary/60 hover:text-secondary transition-all duration-500" data-caret={`pages::${pageId}::hero.cta_secondary`}>
					{hero.cta_secondary}
				</a>
			</div>
		</div>
	</div>

	<div class="absolute bottom-12 left-1/2 -translate-x-1/2 hero-scroll-indicator">
		<div class="w-px h-16 bg-gradient-to-b from-white/0 via-white/20 to-white/40 relative">
			<div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-1.5 h-1.5 rounded-full bg-white/40 hero-scroll-dot"></div>
		</div>
	</div>
</section>
