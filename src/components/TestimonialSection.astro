---
import { img } from '../lib/image';
import { linkify } from '../lib/linkify';

interface Testimonial {
	id: string;
	data: {
		name: string;
		text: string;
		date: string;
		product: string;
		image: string;
	};
}

interface Props {
	pageId: string;
	label: string;
	headline: string;
	subtext?: string;
	style?: 'cards' | 'minimal' | 'featured';
	testimonials: Testimonial[];
}

const { pageId, label, headline, subtext, style = 'cards', testimonials } = Astro.props;
---

<section class="section-spacing bg-gray-50 overflow-hidden">
	<div class="container mx-auto px-4">
		<div class="text-center section-header-spacing reveal-on-scroll">
			<span class="label-badge" data-caret={`pages::${pageId}::testimonials.label`}>{label}</span>
			<h2 class="font-heading text-4xl md:text-5xl text-primary mb-4" data-caret={`pages::${pageId}::testimonials.headline`}>{headline}</h2>
			{subtext && <p class="font-body text-gray-500" data-caret={`pages::${pageId}::testimonials.subtext`}>{subtext}</p>}
		</div>

		{/* ── Minimal: text-focused, no avatars ── */}
		{style === 'minimal' && (
			<div class="max-w-4xl mx-auto space-y-8 reveal-on-scroll">
				{testimonials.map((t) => (
					<blockquote class="text-center">
						<div class="flex justify-center gap-0.5 mb-4">
							{[1,2,3,4,5].map(() => (
								<svg class="w-4 h-4 text-secondary" fill="currentColor" viewBox="0 0 20 20">
									<path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118l-2.8-2.034c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
								</svg>
							))}
						</div>
						<p class="font-body text-gray-600 text-lg leading-relaxed italic mb-4" data-caret={`testimonials::${t.id}::text`} set:html={`&ldquo;${linkify(t.data.text)}&rdquo;`} />
						<footer class="font-heading text-primary text-sm">
							<span data-caret={`testimonials::${t.id}::name`}>{t.data.name}</span>
							<span class="text-gray-300 mx-2">&mdash;</span>
							<span class="text-gray-400" data-caret={`testimonials::${t.id}::product`}>{t.data.product}</span>
						</footer>
					</blockquote>
				))}
			</div>
		)}

		{/* ── Cards: grid of testimonial cards ── */}
		{style === 'cards' && (
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
				{testimonials.map((t) => (
					<div class="bg-white p-6 hover:shadow-lg transition-shadow duration-300 reveal-on-scroll">
						<div class="flex items-center gap-4 mb-4">
							<img
								src={img.avatar(t.data.image)}
								alt={t.data.name}
								class="w-12 h-12 rounded-full object-cover ring-2 ring-secondary/20" data-caret={`testimonials::${t.id}::image`}
							/>
							<div>
								<div class="flex items-center gap-0.5 mb-1">
									{[1,2,3,4,5].map(() => (
										<svg class="w-3.5 h-3.5 text-secondary" fill="currentColor" viewBox="0 0 20 20">
											<path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118l-2.8-2.034c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
										</svg>
									))}
								</div>
								<h4 class="font-heading text-sm text-primary" data-caret={`testimonials::${t.id}::name`}>{t.data.name}</h4>
							</div>
						</div>
						<p class="font-body text-gray-600 text-sm leading-relaxed mb-4" data-caret={`testimonials::${t.id}::text`} set:html={`&ldquo;${linkify(t.data.text)}&rdquo;`} />
						<div class="flex items-center justify-between text-xs text-gray-400 pt-4 border-t border-gray-100">
							<span data-caret={`testimonials::${t.id}::date`}>{t.data.date}</span>
							<span class="text-secondary font-medium">Verified</span>
						</div>
					</div>
				))}
			</div>
		)}

		{/* ── Featured: hero testimonial + supporting row ── */}
		{style === 'featured' && testimonials.length > 0 && (
			<div class="space-y-8">
				{/* Lead testimonial */}
				<div class="max-w-3xl mx-auto bg-white p-10 md:p-14 text-center shadow-sm reveal-on-scroll">
					<div class="flex justify-center gap-0.5 mb-6">
						{[1,2,3,4,5].map(() => (
							<svg class="w-5 h-5 text-secondary" fill="currentColor" viewBox="0 0 20 20">
								<path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118l-2.8-2.034c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
							</svg>
						))}
					</div>
					<p class="font-body text-gray-600 text-xl leading-relaxed italic mb-8" data-caret={`testimonials::${testimonials[0].id}::text`} set:html={`&ldquo;${linkify(testimonials[0].data.text)}&rdquo;`} />
					<div class="flex items-center justify-center gap-4">
						<img
							src={img.avatar(testimonials[0].data.image)}
							alt={testimonials[0].data.name}
							class="w-14 h-14 rounded-full object-cover ring-2 ring-secondary/20" data-caret={`testimonials::${testimonials[0].id}::image`}
						/>
						<div class="text-left">
							<h4 class="font-heading text-primary" data-caret={`testimonials::${testimonials[0].id}::name`}>{testimonials[0].data.name}</h4>
							<p class="text-xs text-gray-400" data-caret={`testimonials::${testimonials[0].id}::product`}>{testimonials[0].data.product}</p>
						</div>
					</div>
				</div>

				{/* Supporting testimonials */}
				{testimonials.length > 1 && (
					<div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-4xl mx-auto">
						{testimonials.slice(1).map((t) => (
							<div class="bg-white p-6 text-center reveal-on-scroll">
								<div class="flex justify-center gap-0.5 mb-3">
									{[1,2,3,4,5].map(() => (
										<svg class="w-3 h-3 text-secondary" fill="currentColor" viewBox="0 0 20 20">
											<path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118l-2.8-2.034c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
										</svg>
									))}
								</div>
								<p class="font-body text-gray-600 text-sm leading-relaxed italic mb-3 line-clamp-3" data-caret={`testimonials::${t.id}::text`} set:html={`&ldquo;${linkify(t.data.text)}&rdquo;`} />
								<p class="font-heading text-xs text-primary" data-caret={`testimonials::${t.id}::name`}>{t.data.name}</p>
							</div>
						))}
					</div>
				)}
			</div>
		)}
	</div>
</section>
