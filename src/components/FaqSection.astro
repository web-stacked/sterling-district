---
import { linkify } from '../lib/linkify';

interface Props {
	pageId: string;
	label: string;
	headline: string;
	faqs: { id: string; data: { question: string; answer: string } }[];
}

const { pageId, label, headline, faqs } = Astro.props;
---

<section class="section-spacing bg-white">
	<div class="container mx-auto px-4">
		<div class="max-w-4xl mx-auto">
			<div class="text-center section-header-spacing reveal-on-scroll">
				<span class="label-badge" data-caret={`pages::${pageId}::faq.label`}>{label}</span>
				<h2 class="font-heading text-4xl md:text-5xl text-primary" data-caret={`pages::${pageId}::faq.headline`}>{headline}</h2>
			</div>

			<div class="space-y-3 reveal-on-scroll">
				{faqs.map((faq, index) => (
					<div class="faq-item border border-gray-200 rounded-sm overflow-hidden transition-all duration-300 hover:border-gray-300">
						<button class="faq-toggle w-full px-6 md:px-8 py-5 flex items-center justify-between text-left bg-white hover:bg-gray-50/50 transition-colors" data-index={index}>
							<span class="font-heading text-base md:text-lg text-primary pr-6" data-caret={`faqs::${faq.id}::question`}>{faq.data.question}</span>
							<span class="faq-icon w-8 h-8 md:w-10 md:h-10 rounded-full bg-secondary/10 flex items-center justify-center flex-shrink-0 transition-all duration-300">
								<svg class="w-4 h-4 md:w-5 md:h-5 text-secondary transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.5v15m7.5-7.5h-15"/>
								</svg>
							</span>
						</button>
						<div class="faq-content grid grid-rows-[0fr] transition-all duration-300 ease-out">
							<div class="overflow-hidden">
								<div class="px-6 md:px-8 pb-6 pt-2">
									<div class="border-t border-gray-100 pt-4">
										<p class="font-body text-gray-600 leading-relaxed text-sm md:text-base" data-caret={`faqs::${faq.id}::answer`} set:html={linkify(faq.data.answer)} />
									</div>
								</div>
							</div>
						</div>
					</div>
				))}
			</div>
		</div>
	</div>
</section>

<style>
	@reference "../styles/base.css";

	.faq-item.active {
		@apply border-secondary/30 shadow-sm;
	}

	.faq-item.active .faq-toggle {
		@apply bg-gray-50/80;
	}

	.faq-item.active .faq-icon {
		@apply bg-secondary;
	}

	.faq-item.active .faq-icon svg {
		@apply text-white rotate-45;
	}

	.faq-item.active .faq-content {
		grid-template-rows: 1fr;
	}
</style>

<script>
	document.querySelectorAll('.faq-toggle').forEach((toggle) => {
		toggle.addEventListener('click', () => {
			const item = toggle.closest('.faq-item');
			const isActive = item?.classList.contains('active');

			document.querySelectorAll('.faq-item').forEach((faq) => {
				if (faq !== item) {
					faq.classList.remove('active');
				}
			});

			item?.classList.toggle('active', !isActive);
		});
	});
</script>
