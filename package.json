{
  "name": "sterling-district",
  "type": "module",
  "version": "0.0.1",
  "description": "CaretCMS starter theme — Astro 7 jewelry storefront on Cloudflare Workers with inline editing and Studio.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/web-stacked/sterling-district.git"
  },
  "bugs": {
    "url": "https://github.com/web-stacked/sterling-district/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "preview:cf": "npm run build && wrangler dev",
